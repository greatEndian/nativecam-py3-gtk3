(author : Fernand Veilleux)
o<boring> sub
(CALL [#begin_x] [#end_x] [#begin_z] [#end_z] [#finishing_passes] [taper] [n_comp])

	#<begin_z>          = #3
	#<end_z>            = #4
	#<finishing_passes> = #5
	#<taper>            = #6
	#<n_comp>           = #7 (tool nose-radius comp on the finish bore wall)

	#<begin_x>          = [#1 / 2 * #<_diameter_mode>]
	#<end_x>            = [#2 / 2 * #<_diameter_mode>]
	#<roughcut>         = [#<_rough_cut> * #<_diameter_mode>]
	#<finishcut>        = [#<_finish_cut> * #<_diameter_mode>]
	
	/ G0 X#<end_x> Z#<begin_z>
	/ G1 Z#<end_z>
	/ o<boring> return

	o10 if [#<finishing_passes> GT 0]
		#<cut_rough_total> = [#<end_x> - #<begin_x> - #<finishcut>]
	o10 else
		#<cut_rough_total> = [#<end_x> - #<begin_x>]
	o10 endif
	
	#<rough_passes> = FUP[#<cut_rough_total> / #<roughcut>]
	#<each_cut> = [#<cut_rough_total> / #<rough_passes>]
	
	o13 if [#<begin_z> GT #<end_z>]
		G0 Z[#<begin_z> + #<_z_rapid>]
	o13 else
		G0 Z[#<end_z> + #<_z_rapid>]
	o13 endif
	G0 X[#<begin_x> - #<_ix_clear>]
	
	M#<_cooling_mode>

	o121 if [#<_tool_usage> LE 1]
		F#<_rough_feed>
		#<x> = #<begin_x>
		o12 repeat [#<rough_passes>]
			G0 Z#<begin_z>
			#<x> = [#<x> + #<each_cut>]
			G0 X#<x>
			G1 Z#<end_z>
			G0 X[#<x> - #<_ix_clear>]
		o12 endrepeat
	o121 endif

	o20 if [#<finishing_passes> AND #<_tool_usage> NE 1]
		F#<_finish_feed>
	(nose geometry and comp side are resolved for BOTH compensated modes: native)
	(hands them to G41.1/G42.1, while In CAM needs the same numbers to offset the)
	(wall itself. Material is outside the bore, so the side inverts OD turning -)
	(and it is proven, not trusted, by the tangency verifier)
	o<bnc_pre> if [#<n_comp> GT 0]
		o<tip_comp_dia> CALL [0] [#<n_comp>]
		#<b_side> = 41
		o<b_sd> if [#<begin_z> LT #<end_z>]
			#<b_side> = 42
		o<b_sd> endif
		#<b_estab> = #<_ix_clear>
		o<b_es> if [#<_tip_lead_w> GT #<_ix_clear>]
			#<b_estab> = #<_tip_lead_w>
		o<b_es> endif
	o<bnc_pre> endif

	o<bnc> if [#<n_comp> EQ 1]
		(compensated finish: the bore wall is a straight Z cut, so nose comp sets)
		(the correct bore DIAMETER. The radial feed from inside the bore out to)
		(the wall at the mouth is the establishing move - _ix_clear well over the)
		(nose radius and in free air)
		o23 repeat [#<finishing_passes>]
			G0 Z#<begin_z>
			G0 X[#<end_x> - #<b_estab>]
			o<tip_comp_on> CALL [#<b_side>]
			G1 X#<end_x>
			G1 Z#<end_z>
			o<tip_comp_off> CALL
			G0 X[#<end_x> - #<_ix_clear> - #<_tip_lead_w>]
		o23 endrepeat
	o<bnc> elseif [#<n_comp> EQ 2]
		(In CAM: a constant-X wall travelling in Z, so one vector offsets both)
		(endpoints and the machine compensates nothing. The retract still clears)
		(by the nose width - the physical round nose trails the control point in)
		(this mode exactly as it does under native comp, and a bare _ix_clear pull)
		(at the deep corner would swing it back into the finished wall)
		#<_tip_off_z> = 0
		#<_tip_off_x> = 0
		o<tip_comp_vec> CALL [#<b_side>] [#<end_z> - #<begin_z>] [0] [0]
		#<b_x>  = [#<end_x> + #<_tip_off_x> * #<_diameter_mode>]
		#<b_bz> = [#<begin_z> + #<_tip_off_z>]
		#<b_ez> = [#<end_z> + #<_tip_off_z>]
		o24 repeat [#<finishing_passes>]
			G0 Z#<b_bz>
			G0 X[#<b_x> - #<b_estab>]
			G1 X#<b_x>
			G1 Z#<b_ez>
			G0 X[#<b_x> - #<_ix_clear> - #<_tip_lead_w>]
		o24 endrepeat
	o<bnc> else
		G0 X[#<end_x> - #<_ix_clear>]
		o21 repeat [#<finishing_passes>]
			G0 Z#<begin_z>
			G0 X#<end_x>
			G1 Z#<end_z>
			G0 X[#<end_x> - #<_ix_clear>]
		o21 endrepeat
	o<bnc> endif
	o20 endif
	
	M9 (cooling off)

	o16 if [#<taper> EQ 0]
		o14 if [#<begin_z> GT #<end_z>]
			G0 Z[#<begin_z> + #<_z_rapid>]
		o14 else
			G0 Z[#<end_z> + #<_z_rapid>]
		o14 endif
	
		G0 X[#<_wp_dia_od> + #<_x_rapid>]
	o16 else
		o17 if [#<begin_z> GT #<end_z>]
			G0 Z[#<begin_z> + #<_z_clear>]
		o17 else
			G0 Z[#<end_z> + #<_z_clear>]
		o17 endif
	o16 endif
	
	o<boring> endsub
