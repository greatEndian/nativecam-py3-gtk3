(copy ready polyline data to the given record area)
(pointer-based variant of poly_copy_mill so forward and reversed arrays can coexist)
o<poly_copy_lathe> sub
(CALL dst[1])

	#[#1]        = 0
	#<src>       = [4981 - #5000 * 11]
	#<src_count> = #[#<src>]
	#10          = [#<src> - 9]

	o11 repeat [#<src_count>]
		o<add_mill_data> CALL [#1] [#[#10]] [#[#10 + 1]] [#[#10 + 2]] [#[#10 + 3]] [#[#10 + 4]] [#[#10 + 5]] [#[#10 + 6]] [#[#10 + 7]]
		#10 = [#10 - 8]
	o11 endrepeat

o<poly_copy_lathe> endsub
