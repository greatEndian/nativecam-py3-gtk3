(Lathe Polyline Milling)
(CALL data ptr[1], start_radius[2], final_radius[3], compensation[4], show final cut[5], dz[6], dx[7], rot[8], tool eng pct[9], cz[10], cx[11],)
(rough_dir[12], fin_offset[13], fin_passes[14], fin_dir[15], op[16], li_len[17], li_ang[18], li_feed[19], lo_len[20], lo_ang[21], lo_feed[22], li_rad[23], lo_rad[24], prefin_off[25], x_wall_dir[26], sec_len[27], nose_comp[28])
(rough_dir / fin_dir : 0 = front to back, 1 = back to front, 2 = both/alternate)
(fin_offset is per-side/radius material left by roughing, removed by fin_passes finish passes)
(op : 0 = roughing + finishing, 1 = roughing only - offset stays on the part, 2 = finishing only)
(prefin_off : pre-finish pass allowance per side - level roughing stops this far above)
(the semi-final shape and one contour pass removes it; 0 = no pre-finish pass)
(x_wall_dir : X wall cut direction in contour passes - 0 with pass, 2 outside to inside)
(sec_len : Z length of an Artificial section. Kept in the signature for the)
(         call sites, but nothing here reads it any more - Artificial slicing)
(         happens at generation time in lathe_sections.py and arrives as the)
(         #3401+ window table. With Sectioning off it must have no effect at)
(         all, which is the whole point of it no longer being read here)
(nose_comp : 1 = add the loaded tool's nose diameter to the contour pass compensation)
(lead in/out : length, angle degrees from the surface, feed - 0 length disables, 0 feed = pass feed)
(Author: Fernand Veilleux / Adapted for Lathe)
o<poly_lathe_mill> sub
        #<pds>           = #1
        #<start_radius>  = #2
        #<final_radius>  = #3
        #<comp>          = #4
        #<show_final>    = #5
        #<dz>            = #6
        #<dx>            = #7
        #<rot>           = #8
        #<tool_eng>      = #9
        #<cz>            = #10
        #<cx>            = #11
        #<rough_dir>     = #12
        #<fin_off>       = #13
        #<fin_passes>    = #14
        #<fin_dir>       = #15
        #<op>            = #16
        #<li_len>        = #17
        #<li_ang>        = #18
        #<li_feed>       = #19
        #<lo_len>        = #20
        #<lo_ang>        = #21
        #<lo_feed>       = #22
        #<li_rad>        = #23
        #<lo_rad>        = #24
        #<prefin_off>    = #25
        #<xw_dir>        = #26
        #<sec_len>       = #27
        #<nose_comp>     = #28

        (Lathe always G18)
        G18

        (compensating in CAM means the machine compensates NOTHING - the offset)
        (lives in the path instead. So a missing offset path is not a fallback)
        (to an uncompensated cut, it is a part turned undersize by the whole)
        (nose radius with a backplot that looks correct. lathe_sections emits a)
        (WARNING comment saying which case it hit; stop here rather than cut it)
        (one path per contour pass, so the table count must cover the pre-finish)
        (pass plus every finish pass - a short table would leave a later pass)
        (reading an unset directory slot and tracing from parameter 0)
        o<cam_req> if [[#<nose_comp> EQ 2] AND [#<_pl_cam_n> LT [#<fin_passes> + 1]]]
                (ABORT, In CAM nose compensation produced no offset path - see the WARNING comment above in this file. Fix it or set Tool nose comp to Native LinuxCNC.)
        o<cam_req> endif

        (reversed record array is built by the polyline cfg; without it force front-to-back)
        o<rev_chk> if [#<_mill_data_rev> LE 0]
                #<rough_dir> = 0
                #<fin_dir>   = 0
        o<rev_chk> endif

        (get and save current coords system offsets)
        #<old_coord_system> = [#<_coord_system> / 10]

        (this feature's record-array/rotation math is shared with the mill)
        (polyline engine, which genuinely needs a rotated/shifted internal)
        (frame to place a 2D profile anywhere on a plane. A plain lathe)
        (polyline never rotates or shifts - dz, dx, rot, cz, cx all stay 0,)
        (so detouring through G57 for it would just copy the active WCS's)
        (own numbers under a different G-word for no reason - skip the)
        (whole detour and stay in the user's own active work coordinate)
        (system throughout when there is truly nothing to rotate or shift)
        #<need_shift> = 0
        o<shift_chk> if [[#<dz> NE 0] OR [#<dx> NE 0] OR [#<rot> NE 0] OR [#<cz> NE 0] OR [#<cx> NE 0]]
                #<need_shift> = 1
        o<shift_chk> endif

        o<useg57> if [#<need_shift> GT 0]
                o<get_offsets> CALL
                #<offset_x> = #<_offsets_x>
                #<offset_z> = #<_offsets_z>
                #<offset_r> = #<_offsets_r>

                (change coords system)
                G#<_off_rot_coord_system>

                (rotate and apply offsets: Z is mill-X, X is mill-Y)
                o<rotate_xy> CALL [#<_offsets_z>] [#<_offsets_x>] [#<_offsets_z> + #<cz>] [#<_offsets_x> + #<cx>] [#<_offsets_r> + #<rot>]
                #<gx_base>   = [#<_rotated_y> + #<dx>]
                #<gz_base>   = [#<_rotated_x> + #<dz>]
                #<rot_total> = [#<_offsets_r> + #<rot>]
                (contour and level passes run unshifted in the working system;)
                (pass offsets are produced by dynamic cutter compensation instead)
                G10 L2 P#5220 X#<gx_base> Z#<gz_base> R#<rot_total>
        o<useg57> endif

        (approach/lift clearance for this polyline: the property's own)
        (value, direct - not layered on the Tool Change's retract)
        (distance/tool-radius clearance, which is a separate concern)
        (already solved in the remapped M6 command)
        #<_pl_z_clear> = #<_pl_zc_ovr>

        o<park_in> if [#<_pl_park_on> GT 0]
                (user start point: begin the operation from here)
                G0 X#<_pl_park_x>
                G0 Z#<_pl_park_z>
        o<park_in> endif

        o<sgn> if [#<start_radius> GE #<final_radius>]
                #<dirsign> = 1
        o<sgn> else
                #<dirsign> = -1
        o<sgn> endif

        (the finish offset is the reserved allowance: it stays even when no)
        (finish passes run here, so roughing always floors above the final shape)
        o<fin_chk> if [#<fin_off> LE 0]
                #<fin_off> = 0
        o<fin_chk> endif
        o<fp_chk> if [#<fin_passes> LT 1]
                #<fin_passes> = 0
        o<fp_chk> endif
        o<op_chk> if [#<op> EQ 1]
                (roughing only: no finish passes, the offset stays on the part)
                #<fin_passes> = 0
        o<op_chk> elseif [[#<op> EQ 2] AND [#<fin_passes> LT 1]]
                (finishing only: at least one pass tracing the final profile)
                #<fin_passes> = 1
        o<op_chk> endif
        (roughing stops short of the profile by the finish offset)
        #<rough_target> = [#<final_radius> + #<dirsign> * #<fin_off>]
        (level roughing floor: the pre-finish offset above the semi-final shape)
        #<step_target> = [#<rough_target> + #<dirsign> * #<prefin_off>]

        (reference radius for keeping a roughing level's lead-out arc tangent)
        (to the NEXT pass's floor - pre-finish if one runs, else finish. The)
        (gap between roughing's own floor and that next floor is exactly the)
        (radius at which the arc's circle - always centered on the level's)
        (own floor line - bottoms out tangent to that next pass's contour. A)
        (bigger user radius is NOT clipped to this; instead lathe_level_pass)
        (pulls the cut end back by the excess so the full-radius circle stays)
        (tangent - see its lead-out section. Depends only on the offset)
        (amounts, so it holds regardless of the corner's shape)
        o<lo_rad_cap> if [#<prefin_off> GT 0]
                #<_lo_rad_cap> = #<prefin_off>
        o<lo_rad_cap> else
                #<_lo_rad_cap> = #<fin_off>
        o<lo_rad_cap> endif

        (WHERE THE MAIN LADDER ENDS. With one floor that is the floor itself,)
        (as it always was. With several, it is the SHALLOWEST - the first)
        (stage - and the stages below it take over from there. Retargeting it)
        (matters: left aiming at the deepest floor, the main ladder overshot)
        (the first one and was clamped onto it, so its last step came out)
        (0.3252 where 0.508 was configured and the descent near the part)
        (turned into three light cuts in a row.)
        (WHERE THE MAIN LADDER ENDS. With one floor that is the floor itself,)
        (as it always was. With several it is the SHALLOWEST - the stages)
        (below take over from there. Left aiming at the deepest floor the main)
        (ladder overshot the first one and was clamped onto it, so its last)
        (step came out 0.3252 where 0.508 was configured and the descent near)
        (the part turned into light cuts in a row.)
        #<lad_tgt> = #<step_target>
        o<lad_fl> if [#<_pl_floor_n> GT 1]
                #<lad_tgt> = #[3380]
        o<lad_fl> endif

        o1001 if [#<lad_tgt> EQ #<start_radius>]
                #<cut_step> = 0
                #<rough_passes> = 1
                #<first_step> = 0
        #<p1_step> = 0
        #<p1_first> = 0
        #<p2_step> = 0
        #<p2_first> = 0
        #<p1_n> = 1
        #<p2_n> = 1
        #<p2_sgn> = 1
        #<lvl_thin> = 0
        o1001 else
                #<rough_passes> = FUP[ABS[#<lad_tgt> - #<start_radius>] / #<_rough_cut>]
                #<cut_step> = [[#<lad_tgt> - #<start_radius>] / #<rough_passes>]
                #<first_step> = #<cut_step>
                (Where the levels are ANCHORED. Spacing them evenly between the)
                (stock and the floor - the default - divides the total by the)
                (pass count, so every step is the same and slightly under the)
                (depth of cut. Anchoring on the finished contour instead takes)
                (full depth-of-cut steps measured from the floor outward, which)
                (puts the odd remainder on the FIRST pass at the stock, where it)
                (is a full-length cut through oversize material, rather than)
                (leaving a level sitting just clear of the finished surface and)
                (grazing it for a sliver.)
                o<anch> if [#<_pl_pass_from> GT 0]
                        #<sgn> = 1
                        o<anch_s> if [#<step_target> LT #<start_radius>]
                                #<sgn> = -1
                        o<anch_s> endif
                        #<cut_step> = [#<sgn> * #<_rough_cut>]
                        (Anchored on the PRE-FINISH contour - rough_target, the)
                        (surface the next pass leaves - not on the roughing)
                        (floor. With no pre-finish pass rough_target and)
                        (step_target are the same radius, so this is exactly the)
                        (roughing floor and nothing changes.)
                        (The grid is rough_target stepped outward by whole)
                        (depths of cut; roughing takes the first level that is)
                        (still clear of its own floor, so the pre-finish)
                        (allowance is never eaten into.)
                        #<k_min> = FUP[ABS[#<step_target> - #<rough_target>] / #<_rough_cut>]
                        #<anch_floor> = [#<rough_target> - #<sgn> * #<k_min> * #<_rough_cut>]
                        (Roughing's floor BECOMES the grid level. Left at)
                        (step_target it would take the grid pass and then one)
                        (more thin descent to the floor - a correct offset pass)
                        (followed by a sliver, which is the chatter this option)
                        (exists to remove. The pre-finish pass then carries one)
                        (whole depth of cut down to its own contour instead of)
                        (the configured allowance, which is the point of)
                        (anchoring on the part rather than on the stock.)
                        #<step_target> = #<anch_floor>
                        (and the LADDER ends at the first floor stage when the)
                        (profile has several - the stages below take over from)
                        (there. With one floor lad_tgt IS anch_floor, so this)
                        (is the same arithmetic it always was.)
                        o<anch_fl> if [#<_pl_floor_n> LE 1]
                                #<lad_tgt> = #<anch_floor>
                        o<anch_fl> endif
                        #<rough_passes> = FUP[ABS[#<lad_tgt> - #<start_radius>] / #<_rough_cut>]
                        (first step takes the remainder, so the last level lands)
                        (exactly on that grid)
                        #<first_step> = [[#<lad_tgt> - #<start_radius>] - #<cut_step> * [#<rough_passes> - 1]]
                o<anch> endif
        o1001 endif

        o<set_feed_rate_and_speed> CALL [#<tool_eng>]

        #<_x_wall_dir> = #<xw_dir>

        (Initial setup for tracing)
        #<_cut_loop_final_z> = 0
        #<_ramp_down_ratio> = 0
        #<_depth_reached> = 0 (0 disables mill depth-step logic inside trace_lathe)
        #<_cut_current_z> = 0

        (scratch record array for a CAM-offset contour pass, sized to the)
        (longest of the passes' paths. Allocated HERE, ahead of the roughing)
        (block, because a finish-only run - op 2 - skips that block entirely and)
        (still needs somewhere to build its pass. One array, refilled per pass:)
        (each pass carries its own offset, and cam_load can walk a table)
        (backwards, so neither several offsets nor both directions need to be)
        (resident at once. _pl_cam_max is 0 in every other mode, which makes)
        (c_top equal to the array end the mesh base used to be computed from -)
        (so native output is unchanged rather than merely equivalent)
        o<cam_base> if [#<_mill_data_rev> GT 0]
                #<c_pds> = [#<_mill_data_rev> + #[#<_mill_data_rev>] * 8 + 1]
        o<cam_base> else
                #<c_pds> = [#<pds> + #[#<pds>] * 8 + 1]
        o<cam_base> endif
        (a record array of N records occupies its count slot plus 8 per record.)
        (With no CAM pass there is no array at all, so c_top must be c_pds)
        (exactly - not c_pds + 1 - or the mesh lands one slot further along than)
        (it used to and native output is no longer the same code)
        (the scratch array serves whichever table feeds the contour passes -)
        (the In-CAM offset paths, or the reachable soft contour - so it is)
        (sized for the larger of the two)
        #<c_need> = #<_pl_cam_max>
        o<c_fc> if [#<_pl_fc_n> GT #<c_need>]
                #<c_need> = #<_pl_fc_n>
        o<c_fc> endif
        (and the native pre-finish contour, which shares the CAM window)
        o<c_pf> if [#<_pl_pf_n> GT #<c_need>]
                #<c_need> = #<_pl_pf_n>
        o<c_pf> endif
        #<c_top> = #<c_pds>
        o<cam_alloc> if [#<c_need> GT 0]
                #<c_top> = [#<c_pds> + #<c_need> * 8 + 1]
        o<cam_alloc> endif

        (roughing: straight level passes stopped at the offset profile,)
        (optionally repeated per Z section window for thin-part rigidity)
        o<rough_00> if [#<op> NE 2]
        o<rpick> if [#<rough_dir> EQ 1]
                #<r_pds> = #<_mill_data_rev>
        o<rpick> else
                #<r_pds> = #<pds>
        o<rpick> endif

        (a re-entrant profile can split one level into several disjoint)
        (safe-to-cut intervals - minimal retract's single reference radius)
        (only ever means "the previous level," which goes stale the moment)
        (an interval-splitting boss is found and stays permanently short of)
        (that boss on every smaller level after. Force full retract instead)
        (for the whole polyline once multi-crossing handling is active -)
        (full retract's target is an absolute upper bound, unconditionally)
        (safe, trading some cycle time for closing that gap)
        o<mx_ret> if [#<_pl_multi_cross> GT 0]
                #<_pl_ret_mode> = 0
        o<mx_ret> endif

        (densified copy for the level-crossing scans only. They read a record's)
        (endpoints and nothing else, so an arc reaches them as its chord - which)
        (for a convex arc lies inside the material and lets every level cut past)
        (the profile by the sagitta less the roughing allowance. The mesh puts)
        (sub-record endpoints on the real radius instead. Built after r_pds is)
        (chosen so it matches the roughing direction, and placed past the end of)
        (the reversed array. The contour passes below keep using r_pds itself,)
        (so they still trace true G2/G3 arcs under dynamic compensation)
        (past the CAM scratch array allocated above, which is itself past the)
        (reversed array - the mesh is the array that grows without bound, so it)
        (goes last and cannot collide with anything placed after it)
        #<m_pds> = #<c_top>
        (safe retract diameter for inside work: back down inside the hole the)
        (tool entered through, clearance below it, never past the spindle axis)
        #<_pl_id_ret> = [#<start_radius> * #<_diameter_mode> - #<_ix_clear>]
        o<id_ret_min> if [#<_pl_id_ret> LT 0]
                #<_pl_id_ret> = 0
        o<id_ret_min> endif

        (The scans run against the mesh copy and nothing else does, so the)
        (reachable envelope goes here: roughing then stops where the tool)
        (back flank actually allows, through the existing crossing logic,)
        (and the contour passes keep tracing the true profile untouched.)
        (_pl_env_count is 0 unless the operator asked for it, and then this)
        (is the plain mesh exactly as before.)
        o<env_use> if [#<_pl_env_count> GT 0]
                #[#<m_pds>] = 0
                #<ei> = 0
                #<ep> = #<_pl_env_base>
                o<env_b> while [#<ei> LT #<_pl_env_count>]
                        o<add_mill_data> CALL [#<m_pds>] [#[#<ep>]] [#[#<ep> + 1]] [1] [0] [0] [0] [0] [0]
                        #<ep> = [#<ep> + 2]
                        #<ei> = [#<ei> + 1]
                o<env_b> endwhile
        o<env_use> else
                o<poly_mesh_lathe> CALL [#<r_pds>] [#<m_pds>] [0.005]
        o<env_use> endif

        (the boundary roughing works away from - the stock OD for outside)
        (work, the existing hole for inside. dirsign already carries which)
        (way into the material is, so the gate below needs only this value)
        o<sr_side> if [#<_pl_side> EQ 1]
                #<stock_r> = #<start_radius>
        o<sr_side> else
                #<stock_r> = [#<_wp_dia_od> / #<_diameter_mode>]
        o<sr_side> endif
        #<e_z> = #[#<r_pds> + 1]
        #<l_z> = #[#<r_pds> + [#[#<r_pds>] - 1] * 8 + 1]
        o<wzd> if [#<e_z> GE #<l_z>]
                #<z_dirw> = 1
        o<wzd> else
                #<z_dirw> = -1
        o<wzd> endif
        (Window length with Sectioning OFF is always the whole profile. sec_len)
        (used to set it here too, which meant a Z section length left in the)
        (field kept slicing the pass into fixed-length windows even with the)
        (Sectioning switch off - the switch appeared to do nothing. sec_len is)
        (an input to the Artificial mode ONLY, and that is consumed at)
        (generation time by lathe_sections.py, which emits its slices in the)
        (#3401+ window table; nothing about it belongs in the off path)
        #<w_len> = [ABS[#<e_z> - #<l_z>] + 1]

        (Sectioning: one unsectioned pass across the full length first, for)
        (levels above the highest edge - "violet" - the largest radius)
        (reached anywhere in the whole profile, above which nothing along)
        (the whole Z length has reached target size yet so a plain)
        (full-length sweep is still safe. Only once a level would drop)
        (below that does roughing switch to full-depth-per-section,)
        (weakest/smallest-diameter first - "blue, green, ..." - for the)
        (remaining depth. Wall-detection/ranking is computed in Python at)
        (generation time by lathe_sections.py, via cfg/lathe/polyline.cfg's)
        (AFTER content - _pl_sect_count stays 0 when Sectioning is off or)
        (the profile couldn't be safely analyzed there, which is what)
        (makes the single pass below cover the entire depth exactly as before)
        o<sec_on> if [[#<_pl_sectioning> GT 0] AND [#<_pl_sect_count> GT 0]]
                #<w_total> = #<_pl_sect_count>
                (raw ceiling is in whatever units X was entered in - convert)
                (to a true radius the same way start/final radius already)
                (are, then clamp defensively: a Final Diameter set deeper)
                (than every point the profile actually draws, or a profile)
                (point beyond the stated Start Diameter, must never leave)
                (phase 1 targeting past step_target or past start_radius)
                #<sect_top_r> = [#<_pl_sect_top_dia> / #<_diameter_mode>]
                o<clamp_top1> if [[#<dirsign> * [#<sect_top_r> - #<step_target>]] LT 0]
                        #<sect_top_r> = #<step_target>
                o<clamp_top1> endif
                o<clamp_top2> if [[#<dirsign> * [#<sect_top_r> - #<start_radius>]] GT 0]
                        #<sect_top_r> = #<start_radius>
                o<clamp_top2> endif
        o<sec_on> else
                #<w_total> = -1
                #<sect_top_r> = #<step_target>
        o<sec_on> endif

        (TWO LADDERS, because the two phases are cutting different things.)
        (greatEndian: "there have to be two different ladders.. one from stock)
        (and second for Final Contour".)
        (  - PHASE 1 sweeps the stock down to the section ceiling. Nothing in)
        (    that range is anywhere near the finished surface, so it is spaced)
        (    EVENLY from the stock and ends exactly on the ceiling.)
        (  - PHASE 2 goes ceiling to floor, which is where the part is, so it)
        (    takes whole depths of cut measured from the FLOOR outward and)
        (    puts its remainder on its own first pass at the ceiling.)
        (One ladder shared by both left phase 2 restarting at the ceiling with)
        (a full step already spent, so it could not land on the floor: 17 gaps)
        (of 0.5080 and then 0.2374, a level grazing the finished surface. And)
        (a ladder PER WINDOW is worse still - the seven section windows start)
        (at different radii, so their levels miss each other by 0.006. Two)
        (ladders, computed once, phase 2 shared by every section window.)
        #<p1_step>  = #<cut_step>
        #<p1_first> = #<first_step>
        #<p2_step>  = #<cut_step>
        #<p2_first> = #<first_step>
        o<lad2> if [#<_pl_sectioning> GT 0]
            o<lad_p1> if [ABS[#<sect_top_r> - #<start_radius>] GT 0.000001]
                #<p1_n> = FUP[ABS[#<sect_top_r> - #<start_radius>] / #<_rough_cut>]
                o<p1_n0> if [#<p1_n> LT 1]
                    #<p1_n> = 1
                o<p1_n0> endif
                #<p1_step>  = [[#<sect_top_r> - #<start_radius>] / #<p1_n>]
                #<p1_first> = #<p1_step>
            o<lad_p1> endif
            o<lad_p2> if [ABS[#<lad_tgt> - #<sect_top_r>] GT 0.000001]
                #<p2_sgn> = 1
                o<p2_sg> if [#<lad_tgt> LT #<sect_top_r>]
                    #<p2_sgn> = -1
                o<p2_sg> endif
                #<p2_n> = FUP[ABS[#<lad_tgt> - #<sect_top_r>] / #<_rough_cut>]
                o<p2_n0> if [#<p2_n> LT 1]
                    #<p2_n> = 1
                o<p2_n0> endif
                o<p2_an> if [#<_pl_pass_from> GT 0]
                    #<p2_step>  = [#<p2_sgn> * #<_rough_cut>]
                    #<p2_first> = [[#<lad_tgt> - #<sect_top_r>] - #<p2_step> * [#<p2_n> - 1]]
                o<p2_an> else
                    #<p2_step>  = [[#<lad_tgt> - #<sect_top_r>] / #<p2_n>]
                    #<p2_first> = #<p2_step>
                o<p2_an> endif
            o<lad_p2> endif
        o<lad2> endif

        #<w_from> = #<e_z>
        (Artificial - _pl_sect_mode 1 - has no violet/ceiling phase at all -)
        (every window gets the full roughing depth, sequentially, so w_idx)
        (starts straight at the first window instead of at -1. Natural -)
        (mode 0 - is unchanged: -1 still means "violet phase pending")
        o<w_idx_init> if [[#<_pl_sectioning> GT 0] AND [#<_pl_sect_mode> EQ 1]]
                #<w_idx> = 0
        o<w_idx_init> else
                #<w_idx> = -1
        o<w_idx_init> endif
        #<_pl_ph1_front_cut> = 0
        (set when phase 1 hands over mid-level, read once that level is done)
        #<ph1_fin> = 0
        (how far phase 1 actually got at the radius where it stopped. Its own)
        (window is the whole profile, so its last pass can cut well past the)
        (first section boundary - phase 2 needs to know that to avoid redoing)
        (that radius in the sections that pass already covered)
        #<_pl_ph1_z_end> = #<e_z>
        (roughing levels begin - bracket for the flank clearance proof)
        o<wh_w> while [1]
