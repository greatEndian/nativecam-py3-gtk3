                        (wall gets its own lead-in from outside and its own)
                        (retract. Slot 2 is that owner, 0 being the pre-finish.)
                        (A profile with no wall yields one sub-path per pass and)
                        (this loop runs exactly once, as it always did.)
                        (REVERSING WALKS THE SUB-PATHS BACKWARDS TOO. cam_load)
                        (reverses the points INSIDE a path; the order the paths)
                        (are cut in has to turn round with them or a reversed)
                        (pass would cut its pieces in the wrong sequence.)
                        (_pl_cam_own is 0 when nothing split, and then entry k)
                        (IS pass k - the directory is the two-slot one it has)
                        (always been and no project without a wall pays a slot)
                        (for this. testing_13_arcs was at 384 of 384 and an)
                        (owner slot in the directory itself took it to 386, so)
                        (In CAM refused to compensate at all.)
                        #<sb_i> = 0
                        o<pf_sub> while [#<sb_i> LT #<_pl_cam_n>]
                                o<pf_ord> if [#<pf_rev> GT 0]
                                        #<sb_k> = [#<_pl_cam_n> - 1 - #<sb_i>]
                                o<pf_ord> else
                                        #<sb_k> = #<sb_i>
                                o<pf_ord> endif
                                #<sb_o> = #<sb_k>
                                o<pf_owt> if [#<_pl_cam_own> GT 0]
                                        #<sb_o> = #[#<_pl_cam_own> + #<sb_k>]
                                o<pf_owt> endif
                                o<pf_own> if [#<sb_o> EQ 0]
                                        o<cam_load> CALL [#<c_pds>] [#[#<_pl_cam_dir> + #<sb_k> * 2]] [#[#<_pl_cam_dir> + #<sb_k> * 2 + 1]] [#<pf_rev>]
                                        o<lathe_poly_pass> CALL [#<c_pds>] [0] [0] [0] [0] [#<_rough_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [2]
                                o<pf_own> endif
                                #<sb_i> = [#<sb_i> + 1]
                        o<pf_sub> endwhile
                o<pf_cam> elseif [#<_pl_pf_n> GT 0]
                        (native: the allowance is IN THIS CONTOUR, not in the D)
                        (word - with a non-zero L the interpreter takes D/2 to)
                        (be the nose radius and scales the orientation term by)
                        (it too, so an allowance folded into D cancels itself)
                        (on any surface parallel to an axis. Pass 0 offset and)
                        (let comp carry the bare nose. See analysis/004.)
                        o<cam_load> CALL [#<c_pds>] [#<_pl_pf_base>] [#<_pl_pf_n>] [#<pf_rev>]
                        o<lathe_poly_pass> CALL [#<c_pds>] [0] [0] [0] [0] [#<_rough_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [#<nose_comp>]
                o<pf_cam> elseif [#<_pl_fc_n> GT 0]
                        (the drawn contour is not wholly reachable, so this)
                        (pass follows the soft one - the same surface the)
                        (roughing levels already stop against)
                        o<cam_load> CALL [#<c_pds>] [#<_pl_fc_base>] [#<_pl_fc_n>] [#<pf_rev>]
                        o<lathe_poly_pass> CALL [#<c_pds>] [#<rough_target> - #<final_radius>] [0] [0] [0] [#<_rough_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [#<nose_comp>]
                o<pf_cam> else
                        o<lathe_poly_pass> CALL [#<r_pds>] [#<rough_target> - #<final_radius>] [0] [0] [0] [#<_rough_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [#<nose_comp>]
                o<pf_cam> endif
                (end pre-finish)
        o<prefin> endif
        o<rough_00> endif

        (pause for measurement/compensation between roughing and the finish)
        (pass - only meaningful if roughing actually ran and a finish pass)
        (is actually about to follow it)
        o<pause_chk> if [[#<_pl_pause_on> GT 0] AND [#<op> NE 2] AND [#<fin_passes> GE 1]]
                M0 (measure the workpiece and dial in tool offset compensation - then resume for the finish pass)
        o<pause_chk> endif

        (finishing passes: step the finish offset down to the final profile)
        o<fin_00> if [#<fin_passes> GE 1]
                (begin finish)
                F#<_finish_feed>
                #<fin_i> = 0
                o<wh_fin> while [#<fin_i> LT #<fin_passes>]
                        #<fin_i> = [#<fin_i> + 1]
                        #<fin_shift> = [#<dirsign> * #<fin_off> * [#<fin_passes> - #<fin_i>] / #<fin_passes>]

                        (f_rev carries the same choice for the CAM branch: there)
                        (is one stored offset path per pass and cam_load walks)
                        (it either way round, so direction is a flag here where)
                        (native mode picks between two prebuilt arrays)
                        o<fpick> if [#<fin_dir> EQ 1]
                                #<pass_pds> = #<_mill_data_rev>
                                #<f_rev>    = 1
                        o<fpick> elseif [#<fin_dir> EQ 2]
                                o<fpick2> if [[#<fin_i> MOD 2] EQ 1]
                                        #<pass_pds> = #<pds>
                                        #<f_rev>    = 0
                                o<fpick2> else
                                        #<pass_pds> = #<_mill_data_rev>
                                        #<f_rev>    = 1
                                o<fpick2> endif
                        o<fpick> else
                                #<pass_pds> = #<pds>
                                #<f_rev>    = 0
                        o<fpick> endif

                        (pass fin_i's own offset path - the fin_shift step-down)
                        (is already baked into each one, so this asks cutter comp)
                        (for no offset and no nose)
                        o<fn_cam> if [#<nose_comp> EQ 2]
                                (the same flat sub-path directory the pre-finish)
                                (walks - see there. This pass owns the entries)
                                (whose slot 2 is fin_i, and takes them backwards)
                                (when f_rev is set for the same reason.)
                                #<sb_i> = 0
                                o<fn_sub> while [#<sb_i> LT #<_pl_cam_n>]
                                        o<fn_ord> if [#<f_rev> GT 0]
                                                #<sb_k> = [#<_pl_cam_n> - 1 - #<sb_i>]
                                        o<fn_ord> else
                                                #<sb_k> = #<sb_i>
                                        o<fn_ord> endif
                                        #<sb_o> = #<sb_k>
                                        o<fn_owt> if [#<_pl_cam_own> GT 0]
                                                #<sb_o> = #[#<_pl_cam_own> + #<sb_k>]
                                        o<fn_owt> endif
                                        o<fn_own> if [#<sb_o> EQ #<fin_i>]
                                                o<cam_load> CALL [#<c_pds>] [#[#<_pl_cam_dir> + #<sb_k> * 2]] [#[#<_pl_cam_dir> + #<sb_k> * 2 + 1]] [#<f_rev>]
                                                o<lathe_poly_pass> CALL [#<c_pds>] [0] [0] [0] [0] [#<_finish_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [2]
                                        o<fn_own> endif
                                        #<sb_i> = [#<sb_i> + 1]
                                o<fn_sub> endwhile
                        o<fn_cam> elseif [#<_pl_fc_n> GT 0]
                                o<cam_load> CALL [#<c_pds>] [#<_pl_fc_base>] [#<_pl_fc_n>] [#<f_rev>]
                                o<lathe_poly_pass> CALL [#<c_pds>] [#<fin_shift>] [0] [0] [0] [#<_finish_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [#<nose_comp>]
                        o<fn_cam> else
                                o<lathe_poly_pass> CALL [#<pass_pds>] [#<fin_shift>] [0] [0] [0] [#<_finish_feed>] [#<li_len>] [#<li_ang>] [#<li_feed>] [#<lo_len>] [#<lo_ang>] [#<lo_feed>] [1] [#<li_rad>] [#<lo_rad>] [#<nose_comp>]
                        o<fn_cam> endif
                o<wh_fin> endwhile
                F#<_rough_feed>
                (end finish)
        o<fin_00> endif

        #<_x_clamp_r> = 999999.0 (disable clamping outside the roughing loop)
        #<_trace_stop_rec> = 0
        #<_x_wall_dir> = 0

        o<ret_side> if [#<_pl_side> EQ 1]
                o<hf_move> CALL [0] [#<_pl_id_ret>] [#<_rough_feed>]
        o<ret_side> else
                o<hf_move> CALL [0] [[#<_wp_dia_od> + #<_X_rapid>]] [#<_rough_feed>]
        o<ret_side> endif
        G40
        o<park_out> if [#<_pl_park_on> GT 0]
                (return to the user start point)
                o<hf_move> CALL [0] [#<_pl_park_x>] [#<_rough_feed>]
                o<hf_move> CALL [1] [#<_pl_park_z>] [#<_rough_feed>]
        o<park_out> endif

        (restore coordinate system - only if the polyline ever left it)
        o<restoreg57> if [#<need_shift> GT 0]
                G#<old_coord_system>
                G10 L2 P#5220 X#<offset_x> Z#<offset_z> R#<offset_r>
        o<restoreg57> endif

o<poly_lathe_mill> endsub
