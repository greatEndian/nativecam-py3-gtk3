(author : Fernand Veilleux)
o<taper_id> sub
(CALL [#begin_x] [#end_x] [#begin_z] [#angle] [#fine_finish] [#path] [n_comp])

	#<begin_z>     = #3
	#<angle>       = #4
	#<fine_finish> = #5
	#<path>        = #6 (Follow drive line = 0 : Angular = 1)
	#<n_comp>      = #7 (tool nose-radius comp on the finish wall)

	#<begin_x>     = [#1 / 2 * #<_diameter_mode>]
	#<end_x>       = [#2 / 2 * #<_diameter_mode>]
	#<diff_x>      = [[#<begin_x> - #<end_x>] / #<_diameter_mode>]
	#<roughcut>    = [#<_rough_cut> * #<_diameter_mode>]
	#<finishcut>   = [#<_finish_cut> * #<_diameter_mode>]

	#<end_z> = [#<begin_z> - [#<diff_x> * TAN[#<angle> - 90]]]

	/ G0 X#<begin_x> Z#<end_z>
	/ G1 X#<end_x> Z#<begin_z>
	/ o<taper_id> return

	o10 if [#<fine_finish> GT 0]
		#<cut_x_total> = [[#<end_x> - #<begin_x>] - #<finishcut>]
	o10 else
		#<cut_x_total> = [#<end_x> - #<begin_x>]
	o10 endif

	F#<_rough_feed>
	#<rough_passes> = FUP[#<cut_x_total> / #<roughcut>]
	#<x_step> = [#<cut_x_total> / #<rough_passes>]
	
	G0 X[#<_wp_dia_od> + #<_X_rapid>]
	o131 if [#<begin_z> GT #<end_z>]
		G0 Z[#<begin_z> + #<_z_rapid>]
	o131 else
		G0 Z[#<end_z> + #<_z_rapid>]
	o131 endif

	#<rough_cut_z_total> = [#<cut_x_total> * SIN[#<angle> - 90] / SIN[#<angle>]]
	#<z_step> = [#<rough_cut_z_total> / #<rough_passes> / #<_diameter_mode>]

	M#<_cooling_mode>
	
	o121 if [#<_tool_usage> LE 1]
		#<x> = #<begin_x>
		#<pass> = 1
		G0 X[#<x> - #<_ix_clear>]
		o122 if [#<path> EQ 0] (0 == Follow drive line)
			#<e_z> = [#<begin_z> + #<z_step> * [#<rough_passes> - 1]]
			o12 repeat [#<rough_passes>]
				G0 X[#<x> - #<_ix_clear>] Z[#<begin_z>]
				G0 X[#<x> + #<x_step>]
				G1 Z[#<e_z>]
				G1 X[#<x>] Z[#<e_z> + #<z_step>]
				G0 X[#<x> - #<_ix_clear>]
				#<x> = [#<x> + #<x_step>]
				#<e_z> = [#<e_z> - #<z_step>]
				#<pass> = [#<pass> + 1]
			o12 endrepeat
		
		o122 else (1 == Angular)
			o13 repeat [#<rough_passes>]
				G0 Z[#<begin_z>]
				#<x> = [#<x> + #<x_step>]
				G0 X#<x>
				G0 Z[#<begin_z>]
				G1 X#<begin_x> Z[#<begin_z> + [#<z_step> * #<pass>]]
				G0 X[#<begin_x> - #<_ix_clear>]
				#<pass> = [#<pass> + 1]
			o13 endrepeat
		o122 endif
	o121 endif

	o20 if [#<fine_finish> AND #<_tool_usage> NE 1]
		F#<_finish_feed>
		(nose-radius comp on the bored finish wall: material is OUTSIDE the bore,)
		(so the side inverts the OD taper - and the establishing move is the)
		(radial feed from inside the bore out to the wall start, _ix_clear well)
		(over the nose radius and in free air. Side is proven by the verifier)
		o<tip_comp_dia> CALL [0] [#<n_comp>]
		#<t_side> = 41
		o<t_sd> if [#<begin_z> LT #<end_z>]
			#<t_side> = 42
		o<t_sd> endif
		(comp-on approach from inside the bore must clear the wall start by at)
		(least the nose radius so the outward radial establishing feed is valid)
		#<t_appr> = #<_ix_clear>
		o<t_ap> if [[#<n_comp> GT 0] AND [#<_tip_lead_w> GT #<_ix_clear>]]
			#<t_appr> = #<_tip_lead_w>
		o<t_ap> endif
		o21 repeat [#<fine_finish>]
			G0 X[#<end_x> - #<t_appr>] Z[#<begin_z>]
			o<nc21> if [#<n_comp> GT 0]
				o<tip_comp_on> CALL [#<t_side>]
				G1 X#<end_x> Z#<begin_z>
			o<nc21> else
				G0 X#<end_x>
				G0 Z#<begin_z>
			o<nc21> endif
			G1 X#<begin_x> Z#<end_z>
			o<tip_comp_off> CALL
			(with comp on, the round nose trails behind the sharp control point;)
			(a bare _ix_clear radial pull at the deep corner swings that trailing)
			(edge back into the finished wall, so clear by the nose width too)
			#<id_rtr> = #<_ix_clear>
			o<idrt> if [#<n_comp> GT 0]
				#<id_rtr> = [#<_ix_clear> + #<_tip_lead_w>]
			o<idrt> endif
			G0 X[#<begin_x> - #<id_rtr>]
		o21 endrepeat
	o20 endif

	M9 (cooling off)
	
	o132 if [#<begin_z> GT #<end_z>]
		G0 Z[#<begin_z> + #<_z_rapid>]
	o132 else
		G0 Z[#<end_z> + #<_z_rapid>]
	o132 endif
	G0 X[#<_wp_dia_od> + #<_X_rapid>]

o<taper_id> endsub
