(author : Fernand Veilleux)
o<facing> sub
(CALL [#begin_x] [#end_x] [#begin_z] [#end_z] [#finishing_passes] [#set_to_0] [#li_len] [#li_ang] [#li_rad] [#lo_len] [#lo_ang] [#lo_rad] [#num_passes] [n_comp])

	#<begin_x>   = [#1 / 2 * #<_diameter_mode>]
	#<end_x>     = [#2 / 2 * #<_diameter_mode>]
	#<begin_z>   = #3
	#<end_z>     = #4

	#<finishing_passes> = #5
	#<li_len> = #7
	#<li_ang> = #8
	#<li_rad> = #9
	#<lo_len> = #10
	#<lo_ang> = #11
	#<lo_rad> = #12
	#<n_comp> = #14 (tool nose-radius comp on the finish face)

	/ G0 X#<begin_x> Z#<end_z>
	/ G1 X#<end_x>
	/ o<facing> return

	#<cut_rough_total> = ABS[#<begin_z> - #<end_z>]
	o10 if [#<finishing_passes> GT 0]
		#<cut_rough_total> = [#<cut_rough_total> - #<_finish_cut>]
	o10 endif

	(roughing pass count is always exactly #num_passes - no depth-of-cut fallback)
	(0 = skip roughing entirely: the finishing pass alone covers begin_z to end_z)
	#<rough_passes> = #13
	#<each_cut> = 0
	o<f_ec> if [#<rough_passes> GT 0]
		#<each_cut> = [#<cut_rough_total> / #<rough_passes>]
	o<f_ec> endif

	o13 if [#<begin_z> GT #<end_z>]
		#<z_factor> = 1
	o13 else
		#<z_factor> = -1
	o13 endif

	(lead geometry, face cut travels -X with the free side toward +Z*z_factor:)
	(0 degrees = along the face in X, 90 = perpendicular in Z)
	#<has_li> = [[#<li_len> GT 0] OR [#<li_rad> GT 0]]
	#<has_lo> = [[#<lo_len> GT 0] OR [#<lo_rad> GT 0]]

	(which way the face travels in X, and the rotation sense fillet_lead needs)
	(so its arc centre lands on the side the lead approaches from)
	#<f_dirx> = -1
	o<f_dx> if [#<end_x> GT #<begin_x>]
		#<f_dirx> = 1
	o<f_dx> endif
	#<f_zdir> = [#<z_factor> * #<f_dirx>]
	(lead line unit directions, pointing away from the cut toward the far)
	(rapid point - the same li_ang/lo_ang convention that places that point)
	#<f_liz> = [#<z_factor> * SIN[#<li_ang>]]
	#<f_lix> = COS[#<li_ang>]
	#<f_loz> = [#<z_factor> * SIN[#<lo_ang>]]
	#<f_lox> = COS[#<lo_ang>]

	G0 Z[#<begin_z> + #<_z_clear> * #<z_factor>]
	M#<_cooling_mode>

	o121 if [[#<_tool_usage> LE 1] AND [#<rough_passes> GT 0]]
		F#<_rough_feed>
		#<z> = #<begin_z>
		o12 repeat [#<rough_passes>]
			#<z> = [#<z> - #<each_cut> * #<z_factor>]
			o<f_li1> if [#<has_li>]
				(round the corner between the lead line and the face with a true)
				(tangent blend - the same construction every other radius in this)
				(toolpath uses. The face itself is not shortened: fillet_lead lands)
				(the arc exactly on the face start, tangent to the face direction)
				(there, and moves only the lead line's own tangent point. The fixed)
				(quarter-arc this replaces was tangent only at 90 degrees and left a)
				(kink at every other lead angle)
				o<fillet_lead> CALL [#<z>] [#<begin_x> / #<_diameter_mode>] [0] [#<f_dirx>] [#<f_liz>] [#<f_lix>] [#<li_rad>] [#<f_zdir>]
				o<f_li1t> if [#<_flt_ok>]
					#<asx> = [#<_flt_t1x> * #<_diameter_mode>]
					#<asz> = #<_flt_t1z>
				o<f_li1t> else
					#<asx> = #<begin_x>
					#<asz> = #<z>
				o<f_li1t> endif
				G0 X[#<asx> + #<li_len> * COS[#<li_ang>] * #<_diameter_mode>]
				G0 Z[#<asz> + #<z_factor> * #<li_len> * SIN[#<li_ang>]]
				o<f_li1s> if [#<li_len> GT 0]
					G1 X#<asx> Z#<asz>
				o<f_li1s> endif
				o<f_li1a> if [#<_flt_ok>]
					o<f_li1d> if [#<_flt_cw>]
						G2 X#<begin_x> Z#<z> I[#<_flt_cx> - [#<asx> / #<_diameter_mode>]] K[#<_flt_cz> - #<asz>]
					o<f_li1d> else
						G3 X#<begin_x> Z#<z> I[#<_flt_cx> - [#<asx> / #<_diameter_mode>]] K[#<_flt_cz> - #<asz>]
					o<f_li1d> endif
				o<f_li1a> endif
			o<f_li1> else
				G0 X#<begin_x>
				G0 Z#<z>
			o<f_li1> endif
			G1 X#<end_x>
			o<f_lo1> if [#<has_lo>]
				(the arc carries the tool on in the direction it was already cutting)
				(and curves it away, rather than reversing it at the face end. Both)
				(tangent points sit on the same circle - centre on the line parallel)
				(to Z through the face end point, tangent to the face there - but only)
				(this one continues the cut; the other doubles the tool straight back)
				(on itself. Sweep is flipped because it is traversed V-to-T1)
				o<fillet_lead> CALL [#<z>] [#<end_x> / #<_diameter_mode>] [0] [-#<f_dirx>] [#<f_loz>] [#<f_lox>] [#<lo_rad>] [-#<f_zdir>]
				#<lex> = #<end_x>
				#<lez> = #<z>
				o<f_lo1a> if [#<_flt_ok>]
					o<f_lo1d> if [#<_flt_cw>]
						G3 X[#<_flt_t1x> * #<_diameter_mode>] Z#<_flt_t1z> I[#<_flt_cx> - [#<end_x> / #<_diameter_mode>]] K[#<_flt_cz> - #<z>]
					o<f_lo1d> else
						G2 X[#<_flt_t1x> * #<_diameter_mode>] Z#<_flt_t1z> I[#<_flt_cx> - [#<end_x> / #<_diameter_mode>]] K[#<_flt_cz> - #<z>]
					o<f_lo1d> endif
					#<lex> = [#<_flt_t1x> * #<_diameter_mode>]
					#<lez> = #<_flt_t1z>
				o<f_lo1a> endif
				o<f_lo1s> if [#<lo_len> GT 0]
					G1 X[#<lex> + #<lo_len> * COS[#<lo_ang>] * #<_diameter_mode>] Z[#<lez> + #<z_factor> * #<lo_len> * SIN[#<lo_ang>]]
				o<f_lo1s> endif
			o<f_lo1> endif
			G0 Z[#<z> + #<_z_clear> * #<z_factor>]
		o12 endrepeat
	o121 endif

	o20 if [#<finishing_passes> AND [#<_tool_usage> NE 1]]
		F#<_finish_feed>
	o<fnc> if [#<n_comp> GT 0]
		(compensated finish: a clean face with a straight run-in that establishes)
		(comp in free air beyond the OD - a nose-comp entry move must be a straight)
		(feed of at least the nose radius, so the lead-in/out arcs are skipped here.)
		(face travels -X at Z=end_z; material is on the +Z*z_factor side, so the comp)
		(side follows z_factor and is proven, not trusted, by the tangency verifier)
		o<tip_comp_dia> CALL [0] [#<n_comp>]
		#<f_side> = 41
		o<f_sd> if [#<z_factor> GT 0]
			#<f_side> = 42
		o<f_sd> endif
		(run-in beyond the OD must clear the face start by at least the nose radius)
		#<f_estab> = #<_x_clear>
		o<f_es> if [[#<_tip_lead_w> * #<_diameter_mode>] GT #<_x_clear>]
			#<f_estab> = [#<_tip_lead_w> * #<_diameter_mode>]
		o<f_es> endif
		o22 repeat [#<finishing_passes>]
			G0 Z[#<end_z> + #<_z_clear> * #<z_factor>]
			G0 X[#<begin_x> + #<f_estab>]
			G0 Z#<end_z>
			o<tip_comp_on> CALL [#<f_side>]
			G1 X#<end_x>
			o<tip_comp_off> CALL
			G0 Z[#<end_z> + #<_z_clear> * #<z_factor>]
		o22 endrepeat
	o<fnc> else
		o21 repeat [#<finishing_passes>]
			o<f_li2> if [#<has_li>]
				(round the corner between the lead line and the face with a true)
				(tangent blend - the same construction every other radius in this)
				(toolpath uses. The face itself is not shortened: fillet_lead lands)
				(the arc exactly on the face start, tangent to the face direction)
				(there, and moves only the lead line's own tangent point. The fixed)
				(quarter-arc this replaces was tangent only at 90 degrees and left a)
				(kink at every other lead angle)
				o<fillet_lead> CALL [#<end_z>] [#<begin_x> / #<_diameter_mode>] [0] [#<f_dirx>] [#<f_liz>] [#<f_lix>] [#<li_rad>] [#<f_zdir>]
				o<f_li2t> if [#<_flt_ok>]
					#<asx> = [#<_flt_t1x> * #<_diameter_mode>]
					#<asz> = #<_flt_t1z>
				o<f_li2t> else
					#<asx> = #<begin_x>
					#<asz> = #<end_z>
				o<f_li2t> endif
				G0 X[#<asx> + #<li_len> * COS[#<li_ang>] * #<_diameter_mode>]
				G0 Z[#<asz> + #<z_factor> * #<li_len> * SIN[#<li_ang>]]
				o<f_li2s> if [#<li_len> GT 0]
					G1 X#<asx> Z#<asz>
				o<f_li2s> endif
				o<f_li2a> if [#<_flt_ok>]
					o<f_li2d> if [#<_flt_cw>]
						G2 X#<begin_x> Z#<end_z> I[#<_flt_cx> - [#<asx> / #<_diameter_mode>]] K[#<_flt_cz> - #<asz>]
					o<f_li2d> else
						G3 X#<begin_x> Z#<end_z> I[#<_flt_cx> - [#<asx> / #<_diameter_mode>]] K[#<_flt_cz> - #<asz>]
					o<f_li2d> endif
				o<f_li2a> endif
			o<f_li2> else
				G0 X#<begin_x>
				G0 Z#<end_z>
			o<f_li2> endif
			G1 X#<end_x>
			o<f_lo2> if [#<has_lo>]
				(the arc carries the tool on in the direction it was already cutting)
				(and curves it away, rather than reversing it at the face end. Both)
				(tangent points sit on the same circle - centre on the line parallel)
				(to Z through the face end point, tangent to the face there - but only)
				(this one continues the cut; the other doubles the tool straight back)
				(on itself. Sweep is flipped because it is traversed V-to-T1)
				o<fillet_lead> CALL [#<end_z>] [#<end_x> / #<_diameter_mode>] [0] [-#<f_dirx>] [#<f_loz>] [#<f_lox>] [#<lo_rad>] [-#<f_zdir>]
				#<lex> = #<end_x>
				#<lez> = #<end_z>
				o<f_lo2a> if [#<_flt_ok>]
					o<f_lo2d> if [#<_flt_cw>]
						G3 X[#<_flt_t1x> * #<_diameter_mode>] Z#<_flt_t1z> I[#<_flt_cx> - [#<end_x> / #<_diameter_mode>]] K[#<_flt_cz> - #<end_z>]
					o<f_lo2d> else
						G2 X[#<_flt_t1x> * #<_diameter_mode>] Z#<_flt_t1z> I[#<_flt_cx> - [#<end_x> / #<_diameter_mode>]] K[#<_flt_cz> - #<end_z>]
					o<f_lo2d> endif
					#<lex> = [#<_flt_t1x> * #<_diameter_mode>]
					#<lez> = #<_flt_t1z>
				o<f_lo2a> endif
				o<f_lo2s> if [#<lo_len> GT 0]
					G1 X[#<lex> + #<lo_len> * COS[#<lo_ang>] * #<_diameter_mode>] Z[#<lez> + #<z_factor> * #<lo_len> * SIN[#<lo_ang>]]
				o<f_lo2s> endif
			o<f_lo2> endif
			G0 Z[#<end_z> + #<_z_clear> * #<z_factor>]
		o21 endrepeat
	o<fnc> endif
	o20 endif

	M9 (cooling off)

	G0 X[#<_wp_dia_od> + #<_x_rapid>]
	G0 Z[#<end_z>]
    o30 if [#6 EQ 1]
        G10 L20 P#5220 Z0.0
    o30 endif

o<facing> endsub
