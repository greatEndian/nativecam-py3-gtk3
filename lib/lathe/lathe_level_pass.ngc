(one straight roughing pass at a fixed diameter over a lathe polyline)
(feeds along Z at the given level and stops at the first crossing of the)
(offset profile - radii, chamfers and tapers are only touched when the)
(level reaches them, and multi-section profiles rough in a single pass)
(sets #<_level_blocked> = 1 and cuts nothing when the profile already)
(rises above the level before the Z window starts)
o<lathe_level_pass> sub
(CALL pds[1] level[2] floor_off[3] w_from[4] w_to[5] pass_feed[6] li_len[7] li_ang[8] li_feed[9] lo_len[10] lo_ang[11] lo_feed[12] li_rad[13] lo_rad[14])

	#<pds>       = #1
	#<level>     = #2
	#<cross_t>   = #3
	#<w_from>    = #4
	#<w_to>      = #5
	#<pass_feed> = #6
	#<li_len>    = #7
	#<li_ang>    = #8
	#<li_feed>   = #9
	#<lo_len>    = #10
	#<lo_ang>    = #11
	#<lo_feed>   = #12
	#<li_rad>    = #13
	#<lo_rad>    = #14
	(where this pass may BEGIN. Defined here, not inside the branch that)
	(sets it: LinuxCNC pre-parses the whole file at load and a named)
	(parameter first assigned in a branch reads as "not defined".)
	(THE WINDOW START IS A RAW PROFILE Z, so the tip started where the SURFACE)
	(starts and the nose - which trails the tip by the orientation vector -)
	(began cutting past it: the drawn segment starts at Z+1.0000 and green began)
	(its cut at Z+1.4000. The level STOP has carried the nose since the stop)
	(table was built, so one end of the pass was compensated and the other was)
	(not. _pl_rgh_oz is already gated in Python - zero unless this polyline)
	(compensates - so there is nothing to decide here, only to subtract)
	#<z_start>   = [#<w_from> - #<_pl_rgh_oz>]
	(the profile-angle approach segment, resolved with z_start below)
	#<pa_on>     = 0
	(1 when this pass's ENTRY LEAD runs entirely through metal a previous)
	(section has already removed - see the ld_air gate after the ramp arming)
	#<ld_air>    = 0
	#<ld_ref>    = 0
	#<ld_seen>   = 0
	#<ld_i>      = 0
	#<ld_az>     = 0
	#<ld_sgn>    = 0
	#<ld_len>    = 0
	#<ld_z0>     = 0
	#<ld_z1>     = 0
	#<ld_wf>     = 0
	#<ld_wt>     = 0
	#<ld_lo>     = 0
	#<ld_hi>     = 0
	#<ld_ov>     = 0
	#<ld_d>      = 0
	#<pa_z>      = 0
	#<pa_x>      = 0
	#<e_bdz>     = 0
	#<e_bdx>     = 0
	#<e_sdz>     = 0
	#<e_sdx>     = 0
	#<e_asl>     = 0
	#<e_reach>   = 999999
	#<_org_z>    = 0
	#<s_reach>   = 999999
	#<s_slp>     = 0
	#<s_zc>      = 0
	#<s_flat>    = 0
	#<s_fz>      = 0
	#<s_cl>      = 0
	#<s_bcl>     = 0
	#<fc_i>      = 0
	#<fc_pz>     = 0
	#<fc_px>     = 0
	#<fc_cz>     = 0
	#<fc_cx>     = 0
	#<s_take>    = 0
	#<pa_dz>     = 0
	(read by the ramp arming below, which now sits outside the entry block)
	#<e_have>    = 0
	(the nearest entry crossing REGARDLESS of the reach bound - the reach)
	(says how far back the pass may START, which is a different question)
	(from what angle it should arrive at. See the ramp arming below.)
	#<e_ahave>   = 0
	#<e_abest>   = 0
	#<e_adz>     = 0
	#<e_adx>     = 0
	#<e_rdz>     = 0
	#<e_rdx>     = 0
	(and the entry segment the pass STARTS on, for a level that never)
	(crosses the entry contour at all)
	(where the entry line reaches this level, used to lengthen a window-bound)
	(cut to the point the next window will start at - see the block below.)
	(The e_t* set is the same latch as e_w* but taken at w_to instead of)
	(w_from, because it is the NEXT window's surface that decides where the)
	(next cut begins - see the second latch in the entry scan.)
	(WHERE THE TOOL IS NOW. _pl_level_z_end still holds the PREVIOUS pass's)
	(finish Z at this point, since this pass overwrites it further down, so)
	(it is the one thing here that knows where the traverse starts from.)
	(Used by the minimal retract to ask what stands between there and this)
	(pass's start.)
	(AND NO COMMENT HERE MAY OPEN WITH "end" OR "begin": ncam_preview reads)
	(COMMENT lines matching those two words as operation markers, so a line)
	(of prose starting with one pops the operation stack and every move after)
	(it is orphaned. That is not cosmetic - it cost a whole measurement run,)
	(which came back with 1793 moves attributed to no operation at all and)
	(zero roughing rapids, looking exactly like a program that had stopped.)
	#<pv_end_z>  = #<_pl_level_z_end>
	#<pk>        = 0
	#<k_i>       = 0
	#<k_pz>      = 0
	#<k_px>      = 0
	#<k_cz>      = 0
	#<k_cx>      = 0
	#<k_lo>      = 0
	#<k_ov1>     = 0
	#<k_hi>      = 0
	#<z_wend>    = 0
	#<e_xze>     = 0
	#<e_tb>      = 0
	#<e_thave>   = 0
	#<e_tdz>     = 0
	#<e_tdx>     = 0
	#<e_taz>     = 0
	#<e_tax>     = 0
	#<e_whave>   = 0
	#<e_wdz>     = 0
	#<e_wdx>     = 0
	#<e_waz>     = 0
	#<e_wax>     = 0
	#<e_xz>      = 0
	#<e_rb>      = 0
	(the lo lead's own geometry. Read unconditionally by the end swap below,)
	(so it cannot be left to the block that resolves it - that block only)
	(runs when a lead-out was actually asked for, and a named parameter first)
	(assigned inside a branch fails LinuxCNC's load-time pre-parse.)
	#<lo_bz>     = 0
	#<lo_bx>     = 0
	#<_lo_leff>  = 0
	#<_lo_reff>  = 0
	o<lif_def> if [#<li_feed> LE 0]
		#<li_feed> = #<pass_feed>
	o<lif_def> endif
	o<lof_def> if [#<lo_feed> LE 0]
		#<lo_feed> = #<pass_feed>
	o<lof_def> endif

	#<rec_count> = #[#<pds>]
	o<zdir> if [#<w_from> GE #<w_to>]
		#<z_dir> = 1
	o<zdir> else
		#<z_dir> = -1
	o<zdir> endif

	(first crossing of the level through the normally-offset profile:)
	(each segment is offset perpendicular by the floor allowance, so walls)
	(and tapers stop the pass the same distance away as the contour passes)
	(arcs are treated as their chords - the pre-finish pass trues them up)
	(the epsilon lets the level exactly on the roughing floor graze it)
	#<d_off> = #<cross_t>
	#<l_eff> = [#<level> + [0.001 * #<_mm>]]
	#<found> = 0
	#<have_prev> = 0
	#<zc>    = [#<w_to> - #<z_dir>]
	#<pz>    = #[#<pds> + 1]
	#<px>    = #[#<pds> + 2]
	#<scan_ptr> = [#<pds> + 9]
	#<scan_i>   = 1

	(WHERE THIS LEVEL STOPS, from the floor contour Python built.)
	(The scan below works it out itself, offsetting every segment of the)
	(record array perpendicular by the single number cross_t. That cannot)
	(hold two allowances, and it showed: with a radial 0.508 and an axial)
	(2.000 roughing stopped 0.762 from the end wall - fin_off + prefin_off -)
	(because nothing here knew about the axial value. The stop table could)
	(not rescue it either, being bounded to EXTENDING a cut and never)
	(pulling one back.)
	(The table is the same contour, blended by each surface own normal and)
	(with its corners already joined, so this walk needs neither the offset)
	(arithmetic nor the gap connector the scan below carries for corners)
	(its independently offset segments leave open. Read the table, move.)
	o<flc> if [#<_pl_flc_n> GT 1]
		#<fc_i>  = 0
		#<fc_pz> = #[#<_pl_flc_base>]
		#<fc_px> = #[#<_pl_flc_base> + 1]
		(already above the level where the contour starts)
		o<fc_st> if [#<fc_px> GE #<l_eff>]
			#<zc> = #<fc_pz>
			#<found> = 1
		o<fc_st> endif
		o<fc_w> while [#<fc_i> LT [#<_pl_flc_n> - 1]]
			#<fc_i>  = [#<fc_i> + 1]
			#<fc_cz> = #[#<_pl_flc_base> + #<fc_i> * 2]
			#<fc_cx> = #[#<_pl_flc_base> + #<fc_i> * 2 + 1]
			o<fc_x> if [[#<found> EQ 0] AND [#<fc_px> LT #<l_eff>] AND [#<fc_cx> GE #<l_eff>]]
				o<fc_d> if [ABS[#<fc_cx> - #<fc_px>] GT 0.000001]
					#<zc> = [#<fc_pz> + [#<fc_cz> - #<fc_pz>] * [#<l_eff> - #<fc_px>] / [#<fc_cx> - #<fc_px>]]
				o<fc_d> else
					#<zc> = #<fc_cz>
				o<fc_d> endif
				#<found> = 1
			o<fc_x> endif
			#<fc_pz> = #<fc_cz>
			#<fc_px> = #<fc_cx>
		o<fc_w> endwhile
		#<scan_i> = #<rec_count>
	o<flc> endif

	o<scan01> while [#<scan_i> LT #<rec_count>]
		#<scan_i> = [#<scan_i> + 1]
		#<cz> = #[#<scan_ptr>]
		#<cx> = #[#<scan_ptr> + 1]
		#<s_len> = SQRT[[#<cz> - #<pz>] * [#<cz> - #<pz>] + [#<cx> - #<px>] * [#<cx> - #<px>]]
		o<c_seg> if [[#<found> EQ 0] AND [#<s_len> GT 0.0001]]
			(outward normal of the segment, pointing away from the material)
			#<n_z> = [#<z_dir> * [#<cx> - #<px>] / #<s_len>]
			#<n_x> = [-#<z_dir> * [#<cz> - #<pz>] / #<s_len>]
			#<q1z> = [#<pz> + #<d_off> * #<n_z>]
			#<q1x> = [#<px> + #<d_off> * #<n_x>]
			#<q2z> = [#<cz> + #<d_off> * #<n_z>]
			#<q2x> = [#<cx> + #<d_off> * #<n_x>]

			(corner connector: adjacent segments offset independently and can)
			(leave a gap or overlap at the joint between them - e.g. a wall)
			(segment offsets purely in Z while a neighboring fillet arc chord)
			(offsets diagonally, so their offset ranges don't meet exactly.)
			(bridge the previous segment's offset end to this one's offset)
			(start with a straight connector before testing this segment.)
			o<gap> if [#<have_prev>]
				o<gap_hit> if [[#<pq2x> LT #<l_eff>] AND [#<q1x> GE #<l_eff>]]
					#<zc> = [#<pq2z> + [#<q1z> - #<pq2z>] * [#<l_eff> - #<pq2x>] / [#<q1x> - #<pq2x>]]
					#<found> = 1
				o<gap_hit> elseif [[#<pq2x> GE #<l_eff>] AND [#<q1x> LT #<l_eff>]]
					#<zc> = [#<pq2z> + [#<q1z> - #<pq2z>] * [#<l_eff> - #<pq2x>] / [#<q1x> - #<pq2x>]]
					#<found> = 1
				o<gap_hit> endif
			o<gap> endif

			o<c_ent> if [#<found>]
				(matched by the corner connector above)
			o<c_ent> elseif [[#<scan_i> EQ 2] AND [#<q1x> GE #<l_eff>]]
				(offset profile already above the level at its start)
				#<zc> = #<q1z>
				#<found> = 1
			o<c_ent> elseif [[#<q1x> LT #<l_eff>] AND [#<q2x> GE #<l_eff>]]
				#<zc> = [#<q1z> + [#<q2z> - #<q1z>] * [#<l_eff> - #<q1x>] / [#<q2x> - #<q1x>]]
				#<found> = 1
			o<c_ent> endif

			#<pq2z> = #<q2z>
			#<pq2x> = #<q2x>
			#<have_prev> = 1
		o<c_seg> endif
		#<pz> = #<cz>
		#<px> = #<cx>
		#<scan_ptr> = [#<scan_ptr> + 8]
	o<scan01> endwhile

	(multi-crossing continuation: the scan above always finds the array's very)
	(first crossing, which is stale/uninformative once w_from has moved past)
	(the array's true start on a continuation call from poly_lathe_mill's)
	(disjoint-interval loop - a second, direction-aware walk instead replays)
	(every crossing in array order to work out whether the profile is)
	(currently above the level right at w_from itself - the running state)
	(folds in every crossing at-or-before w_from, in order, then freezes -)
	(and separately finds the next qualifying entry into blocked territory)
	(strictly past w_from, for setting the cut target when not blocked)
	o<mcross> if [#<_pl_multi_cross> GT 0]
		#<mc_state> = 0
		#<mc_have_first> = 0
		#<mc_have_prev> = 0
		#<mc_wf_state> = -1
		#<mc_qual_found> = 0
		#<mc_zc> = [#<w_to> - #<z_dir>]
		#<mc_pz> = #[#<pds> + 1]
		#<mc_px> = #[#<pds> + 2]
		#<mc_scan_ptr> = [#<pds> + 9]
		#<mc_i> = 1

		(THE SAME REPLAY, walked on the floor contour Python built. It has to)
		(be the same source as the scan above or the two disagree about where)
		(the level stops - and this one wins, because with multi-crossing on)
		(it sets the cut target. That is why fixing the scan alone changed)
		(nothing: roughing still stopped 0.762 from a wall set to 2.000.)
		(Simpler than the walk below, because a joined contour has at most)
		(ONE crossing per segment: no gap connector, and no pair of)
		(independent events to keep apart.)
		o<mc_flc> if [#<_pl_flc_n> GT 1]
			#<fc_i>  = 0
			#<fc_pz> = #[#<_pl_flc_base>]
			#<fc_px> = #[#<_pl_flc_base> + 1]
			o<mcf_st> if [#<fc_px> GE #<l_eff>]
				#<mc_state> = 1
			o<mcf_st> endif
			o<mcf_w> while [#<fc_i> LT [#<_pl_flc_n> - 1]]
				#<fc_i>  = [#<fc_i> + 1]
				#<fc_cz> = #[#<_pl_flc_base> + #<fc_i> * 2]
				#<fc_cx> = #[#<_pl_flc_base> + #<fc_i> * 2 + 1]
				#<mc_seg_found> = 0
				o<mcf_ent> if [[#<fc_px> LT #<l_eff>] AND [#<fc_cx> GE #<l_eff>]]
					#<mc_seg_dirup> = 1
					#<mc_seg_found> = 1
				o<mcf_ent> elseif [[#<fc_px> GE #<l_eff>] AND [#<fc_cx> LT #<l_eff>]]
					#<mc_seg_dirup> = 0
					#<mc_seg_found> = 1
				o<mcf_ent> endif
				o<mcf_t> if [#<mc_seg_found>]
					o<mcf_d> if [ABS[#<fc_cx> - #<fc_px>] GT 0.000001]
						#<mc_seg_tz> = [#<fc_pz> + [#<fc_cz> - #<fc_pz>] * [#<l_eff> - #<fc_px>] / [#<fc_cx> - #<fc_px>]]
					o<mcf_d> else
						#<mc_seg_tz> = #<fc_cz>
					o<mcf_d> endif
					o<mcf_past> if [[#<z_dir> * [#<mc_seg_tz> - #<w_from>]] LT [-0.0001]]
						o<mcf_frz> if [#<mc_wf_state> LT 0]
							#<mc_wf_state> = #<mc_state>
						o<mcf_frz> endif
						o<mcf_q> if [[#<mc_seg_dirup>] AND [#<mc_qual_found> EQ 0]]
							#<mc_qual_found> = 1
							#<mc_zc> = #<mc_seg_tz>
						o<mcf_q> endif
					o<mcf_past> else
						#<mc_state> = #<mc_seg_dirup>
					o<mcf_past> endif
				o<mcf_t> endif
				#<fc_pz> = #<fc_cz>
				#<fc_px> = #<fc_cx>
			o<mcf_w> endwhile
			#<mc_i> = #<rec_count>
		o<mc_flc> endif

		o<mc01> while [#<mc_i> LT #<rec_count>]
			#<mc_i> = [#<mc_i> + 1]
			#<mc_cz> = #[#<mc_scan_ptr>]
			#<mc_cx> = #[#<mc_scan_ptr> + 1]
			#<mc_slen> = SQRT[[#<mc_cz> - #<mc_pz>] * [#<mc_cz> - #<mc_pz>] + [#<mc_cx> - #<mc_px>] * [#<mc_cx> - #<mc_px>]]
			o<mc_seg> if [#<mc_slen> GT 0.0001]
				#<mc_nz> = [#<z_dir> * [#<mc_cx> - #<mc_px>] / #<mc_slen>]
				#<mc_nx> = [-#<z_dir> * [#<mc_cz> - #<mc_pz>] / #<mc_slen>]
				#<mc_q1z> = [#<mc_pz> + #<d_off> * #<mc_nz>]
				#<mc_q1x> = [#<mc_px> + #<d_off> * #<mc_nx>]
				#<mc_q2z> = [#<mc_cz> + #<d_off> * #<mc_nz>]
				#<mc_q2x> = [#<mc_cx> + #<d_off> * #<mc_nx>]

				o<mc_first_chk> if [#<mc_have_first> EQ 0]
					o<mc_st0> if [#<mc_q1x> GE #<l_eff>]
						#<mc_state> = 1
					o<mc_st0> endif
					#<mc_have_first> = 1
				o<mc_first_chk> endif

				(gap-connector and in-segment crossings are independent events,)
				(not alternatives - a corner where two differently-oriented)
				(segments' offsets overshoot each other, e.g. a pure-radial)
				(step immediately followed by a shallow taper, can genuinely)
				(enter blocked territory via the gap bridge AND separately)
				(exit it again within the very next segment's own body. Testing)
				(them as an if/elseif pair - matching lathe_level_pass's plain)
				(single-crossing scan above, where only the first-ever match)
				(matters so the distinction is invisible - would silently drop)
				(the second event here, where every crossing must be replayed)
				#<mc_gap_found> = 0
				o<mc_gap> if [#<mc_have_prev>]
					#<mc_q1_prog>  = [-#<z_dir> * #<mc_q1z>]
					#<mc_pq2_prog> = [-#<z_dir> * #<mc_pq2z>]
					o<mc_foldchk> if [#<mc_q1_prog> GE [#<mc_pq2_prog> - 0.0001]]
						o<mc_gap_hit> if [[#<mc_pq2x> LT #<l_eff>] AND [#<mc_q1x> GE #<l_eff>]]
							#<mc_gap_tz> = [#<mc_pq2z> + [#<mc_q1z> - #<mc_pq2z>] * [#<l_eff> - #<mc_pq2x>] / [#<mc_q1x> - #<mc_pq2x>]]
							#<mc_gap_dirup> = 1
							#<mc_gap_found> = 1
						o<mc_gap_hit> elseif [[#<mc_pq2x> GE #<l_eff>] AND [#<mc_q1x> LT #<l_eff>]]
							#<mc_gap_tz> = [#<mc_pq2z> + [#<mc_q1z> - #<mc_pq2z>] * [#<l_eff> - #<mc_pq2x>] / [#<mc_q1x> - #<mc_pq2x>]]
							#<mc_gap_dirup> = 0
							#<mc_gap_found> = 1
						o<mc_gap_hit> endif
					o<mc_foldchk> endif
				o<mc_gap> endif

				#<mc_seg_found> = 0
				o<mc_ent> if [[#<mc_q1x> LT #<l_eff>] AND [#<mc_q2x> GE #<l_eff>]]
					#<mc_seg_tz> = [#<mc_q1z> + [#<mc_q2z> - #<mc_q1z>] * [#<l_eff> - #<mc_q1x>] / [#<mc_q2x> - #<mc_q1x>]]
					#<mc_seg_dirup> = 1
					#<mc_seg_found> = 1
				o<mc_ent> elseif [[#<mc_q1x> GE #<l_eff>] AND [#<mc_q2x> LT #<l_eff>]]
					#<mc_seg_tz> = [#<mc_q1z> + [#<mc_q2z> - #<mc_q1z>] * [#<l_eff> - #<mc_q1x>] / [#<mc_q2x> - #<mc_q1x>]]
					#<mc_seg_dirup> = 0
					#<mc_seg_found> = 1
				o<mc_ent> endif

				o<mc_use_gap> if [#<mc_gap_found>]
					o<mc_ispast_g> if [[#<z_dir> * [#<mc_gap_tz> - #<w_from>]] LT [-0.0001]]
						o<mc_freeze_g> if [#<mc_wf_state> LT 0]
							#<mc_wf_state> = #<mc_state>
						o<mc_freeze_g> endif
						o<mc_qual_g> if [[#<mc_gap_dirup>] AND [#<mc_qual_found> EQ 0]]
							#<mc_qual_found> = 1
							#<mc_zc> = #<mc_gap_tz>
						o<mc_qual_g> endif
					o<mc_ispast_g> else
						#<mc_state> = #<mc_gap_dirup>
					o<mc_ispast_g> endif
				o<mc_use_gap> endif

				o<mc_use_seg> if [#<mc_seg_found>]
					o<mc_ispast_s> if [[#<z_dir> * [#<mc_seg_tz> - #<w_from>]] LT [-0.0001]]
						o<mc_freeze_s> if [#<mc_wf_state> LT 0]
							#<mc_wf_state> = #<mc_state>
						o<mc_freeze_s> endif
						o<mc_qual_s> if [[#<mc_seg_dirup>] AND [#<mc_qual_found> EQ 0]]
							#<mc_qual_found> = 1
							#<mc_zc> = #<mc_seg_tz>
						o<mc_qual_s> endif
					o<mc_ispast_s> else
						#<mc_state> = #<mc_seg_dirup>
					o<mc_ispast_s> endif
				o<mc_use_seg> endif

				#<mc_pq2z> = #<mc_q2z>
				#<mc_pq2x> = #<mc_q2x>
				#<mc_have_prev> = 1
			o<mc_seg> endif
			#<mc_pz> = #<mc_cz>
			#<mc_px> = #<mc_cx>
			#<mc_scan_ptr> = [#<mc_scan_ptr> + 8]
		o<mc01> endwhile

		o<mc_finalize> if [#<mc_wf_state> LT 0]
			#<mc_wf_state> = #<mc_state>
		o<mc_finalize> endif

		o<mc_decide> if [#<mc_wf_state> GT 0]
			#<_level_blocked> = 1
			o<lathe_level_pass> return
		o<mc_decide> else
			#<found> = #<mc_qual_found>
			#<zc> = #<mc_zc>
		o<mc_decide> endif
	o<mcross> endif

