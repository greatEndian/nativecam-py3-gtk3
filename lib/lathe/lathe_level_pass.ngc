				#<pa_z> = [#<z_start> + #<z_dir> * #<pa_dz>]
				#<pa_x> = [#<level> + #<z_dir> * #<pa_dz> * #<e_slope>]
				(THE RAMP MUST COME IN FROM THE STOCK SIDE. Its whole job is)
				(to arrive parallel to the surface through material that is)
				(already gone; a direction that puts its start INSIDE the)
				(level dives into the part and climbs back out, which is)
				(what greatEndian saw at the front of testing_15_5 - the)
				(lead-in descending to r33.7160, the NEXT pass's level, then)
				(returning to r34.2240 at Z0. The entry segment there rises)
				(with the front face, so copying its angle points the wrong)
				(way. No ramp is the right answer in that case, and the)
				(plain lead-in already handles it.)
				o<pa_side> if [[#<_pl_x_sgn> * [#<pa_x> - #<level>]] GT 0.000001]
					#<pa_on> = 1
				o<pa_side> endif
			o<e_room> endif
		o<e_proj> endif
	o<e_arm> endif


	(exposed for callers doing their own disjoint-interval scanning after this)
	(call - e.g. lathe_level_next_start needs to know where THIS pass actually)
	(stopped cutting, to search for a further interval past it)
	#<_pl_level_z_end> = #<z_end>

	(resolve the lead-out radius and the possibly-shortened cut end BEFORE the)
	(straight cut, so a cut ending near a wall can stop just early enough that)
	(a full-radius lead-out arc still lands tangent to the pre-finish contour)
	(instead of the radius being clipped to a constant. z_end - the logical)
	(floor crossing - is left untouched for the interval/blocking logic and)
	(the _pl_level_z_end export; only the physical straight-cut endpoint and)
	(the fillet's own tangent point move)
	#<z_end_cut> = #<z_end>

	o<lo_res> if [[#<lo_len> GT 0] OR [#<lo_rad> GT 0]]
		(lead-out line direction: unit vector pointing from the exit toward)
		(the far rapid point - 0 degrees along Z surface, 90 radial)
		#<lo_bz> = [#<z_dir> * COS[#<lo_ang>]]
		#<lo_bx> = [#<_pl_x_sgn> * SIN[#<lo_ang>]]
		#<_lo_cos> = [#<z_dir> * #<lo_bz>]
		#<_lo_leff> = #<lo_len>

		(mirrors the lead-in's own _li_leff/li_cap_all cap above, and bounds the)
		(same end of the interval it does. The retreat travels BACKWARD, from)
		(z_end toward w_from, for either z_dir - lo_bz carries z_dir, so the)
		(move Z[end_z + _lo_leff * lo_bz] always runs against the cutting)
		(direction. What it must not reach past is therefore w_from: on a)
		(multi-crossing continuation interval that is where the boss blocking)
		(the sweep sits. Measuring toward w_to instead bounded the one direction)
		(the retreat never travels, which both deleted the lead-out outright)
		(whenever a pass ran its whole window - z_end clamped to w_to, so zero)
		(room, which is what left every artificial slice ending bare - and let)
		(a continuation interval retreat run back over its own start when the)
		(room ahead happened to be large. Gated on multi-crossing so the)
		(single-crossing path stays byte-for-byte unchanged)
		(NOT ON THE FIRST INTERVAL. This cap keeps a continuation interval's)
		(retreat from running back over its own start, where the boss that)
		(blocked the sweep is sitting. The first interval has no such)
		(obstruction behind it - it starts at the polyline's Begin Z and)
		(everything in front of that is air - so capping there just takes)
		(the lead the operator asked for: on testing_15_4's chamfer level a)
		(1.000 mm lead came out 0.125 because the cut is 0.088 long.)
		o<lo_cap_all> if [[#<_pl_multi_cross> GT 0] AND [#<w_from> LT [#<_pl_begin_z> - 0.000001]]]
			#<_lo_room> = ABS[#<z_end> - #<w_from>]
			o<lo_lcap> if [#<_lo_cos> GT 0.0001]
				#<_lo_lmax> = [#<_lo_room> / #<_lo_cos>]
				o<lo_lcap2> if [#<_lo_leff> GT #<_lo_lmax>]
					#<_lo_leff> = #<_lo_lmax>
				o<lo_lcap2> endif
			o<lo_lcap> endif
		o<lo_cap_all> endif

		(radius is bounded by how much straight lead length there is to blend)
		(into - a big radius with a short lead would swing wider than lo_len)
		(can absorb; half-angle from the arrival vs lead-out directions)
		#<_lo_reff> = #<lo_rad>
		o<lo_rlen> if [#<lo_len> GT 0]
			#<_lo_sin> = ABS[#<z_dir> * #<lo_bx>]
			#<_lo_rmax> = [#<_lo_leff> * #<_lo_sin> / [1 + #<_lo_cos>]]
			o<lo_rlen2> if [#<_lo_reff> GT #<_lo_rmax>]
				#<_lo_reff> = #<_lo_rmax>
			o<lo_rlen2> endif
		o<lo_rlen> endif

		(pre-finish tangency by POSITION, not by clipping the radius: the arc's)
		(circle is always centered on the cut end in Z, so its lowest point is)
		(radius below that - see poly_lathe_mill.ngc lo_rad_cap. To keep the)
		(user's radius AND land tangent to the pre-finish contour, which sits)
		(_lo_rad_cap toward the wall from the roughing floor, pull the cut end)
		(back toward the window start by exactly the excess, so the circle)
		(bottoms out ON the pre-finish line rather than past it. Guard: a short)
		(multi-crossing interval with no room to pull back falls back to)
		(clipping the radius, so it still cannot overflow)
		o<lo_pull> if [[#<lo_rad> GT 0] AND [#<_lo_reff> GT #<_lo_rad_cap>]]
			#<z_end_try> = [#<z_end> + #<z_dir> * [#<_lo_reff> - #<_lo_rad_cap>]]
			o<lo_pull2> if [[#<z_dir> * [#<w_from> - #<z_end_try>]] GT 0.0001]
				#<z_end_cut> = #<z_end_try>
			o<lo_pull2> else
				#<_lo_reff> = #<_lo_rad_cap>
			o<lo_pull2> endif
		o<lo_pull> endif
	o<lo_res> endif

	(Skip a pass too short to be worth making. A level whose cut is only a)
	(fraction of the tool sits almost entirely inside the pre-finish allowance)
	(anyway - the contour pass that follows takes the same metal in one go - so)
	(cutting it costs an approach and a retract to remove almost nothing.)
	(BEFORE the approach and the lead-in, not after them: returning later still)
	(left the whole entry behind - retract, rapid to the lead start, then a FEED)
	(into the workpiece - and then walked away without cutting the pass it had)
	(just entered for. A skipped pass now emits no motion at all.)
	(Measured on z_end_cut, which is why the lead-out resolution above it moved)
	(up here too: that block is pure arithmetic, it emits nothing, and the pull)
	(back it applies is what decides how long this cut really is. Measuring the)
	(raw crossing instead read the pass longer than it is and the gate missed)
	(the passes it exists for.)
	(_pl_level_z_end is already set above, so the disjoint-interval scan still)
	(knows where this level reached and carries on past it.)
	o<shrt> if [#<_pl_min_pass> GT 0]
		o<shrt2> if [ABS[#<z_end_cut> - #<z_start>] LT #<_pl_min_pass>]
			o<lathe_level_pass> return
		o<shrt2> endif
	o<shrt> endif


	(approach: full retract above stock, or minimal retract just above the)
	(previous pass level - safe because that band is already cut)
	o<ret_md> if [#<_pl_ret_mode> GT 0]
		#<ret_x> = [[#<_pl_prev_lvl> + #<_pl_ret_dist>] * #<_diameter_mode>]
		o<ret_cap> if [[#<_pl_side> EQ 0] AND [#<ret_x> GT [#<_wp_dia_od> + #<_x_clear>]]]
			#<ret_x> = [#<_wp_dia_od> + #<_x_clear>]
		o<ret_cap> endif
		G0 X#<ret_x>
	o<ret_md> else
		o<rt_side> if [#<_pl_side> EQ 1]
			G0 X#<_pl_id_ret>
		o<rt_side> else
			G0 X[#<_wp_dia_od> + #<_x_clear>]
		o<rt_side> endif
	o<ret_md> endif
	(where the approach LANDS: the start of the profile-angle segment when)
	(there is one, else the pass start itself. Both the lead-in branch and)
	(the plain-rapid branch use it, because the segment is NOT part of the)
	(lead-in - it is there whether or not a lead-in was asked for, and the)
	(project that wanted it has lead-in length and radius both 0.)
	#<ap_z> = #<z_start>
	#<ap_x> = #<level>
	o<ap_use> if [#<pa_on>]
		#<ap_z> = #<pa_z>
		#<ap_x> = #<pa_x>
	o<ap_use> endif

	o<lead_in> if [[#<li_len> GT 0] OR [#<li_rad> GT 0]]
		(a level pass always travels along Z at constant X, so the toolpath's)
		(own direction at the entry is always pure Z - no profile lookup needed)
		#<li_bz> = [#<z_dir> * COS[#<li_ang>]]
		#<li_bx> = [#<_pl_x_sgn> * SIN[#<li_ang>]]
		#<_li_leff> = #<li_len>
		#<_li_reff> = #<li_rad>

		(multi-crossing continuation intervals can be short - the entry's own)
		(depth excursion, li_len times cos of li_ang, must not reach past z_end, or)
		(the entry line itself would cut into territory this interval was)
		(never meant to touch. z_end is already known here regardless of)
		(whether this is the first or a later interval, so cap against the)
		(actual room instead of the caller unconditionally zeroing the whole)
		(lead for every interval after the first. Gated on multi-crossing so)
		(the single-crossing path is byte-for-byte unchanged - it never had)
		(this cap and first intervals there are assumed to have enough room.)
		(li_rad itself is deliberately left uncapped, matching the contour)
		(pass's own lead-in in lathe_poly_pass.ngc, which has never capped)
		(it either - only the straight length risks cutting past z_end)
		(NOT ON THE FIRST INTERVAL. This cap keeps a continuation interval's)
		(approach from running back over its own start, where the boss that)
		(blocked the sweep is sitting. The first interval has no such)
		(obstruction behind it - it starts at the polyline's Begin Z and)
		(everything in front of that is air - so capping there just takes)
		(the lead the operator asked for: on testing_15_4's chamfer level a)
		(1.000 mm lead came out 0.125 because the cut is 0.088 long.)
		o<li_cap_all> if [[#<_pl_multi_cross> GT 0] AND [#<w_from> LT [#<_pl_begin_z> - 0.000001]]]
			#<_li_room> = ABS[#<z_end> - #<w_from>]
			#<_li_cos>  = [#<z_dir> * #<li_bz>]
			o<li_lcap> if [#<_li_cos> GT 0.0001]
				#<_li_lmax> = [#<_li_room> / #<_li_cos>]
				o<li_lcap2> if [#<_li_leff> GT #<_li_lmax>]
					#<_li_leff> = #<_li_lmax>
				o<li_lcap2> endif
			o<li_lcap> endif
		o<li_cap_all> endif

		#<_flt_ok> = 0
		o<li_geom> if [#<_li_reff> GT 0]
			o<fillet_lead> CALL [#<ap_z>] [#<ap_x>] [-#<z_dir>] [0] [#<li_bz>] [#<li_bx>] [#<_li_reff>] [#<z_dir>]
		o<li_geom> endif

		o<li_base> if [#<_flt_ok>]
			#<li_baz> = #<_flt_t1z>
			#<li_bax> = #<_flt_t1x>
		o<li_base> else
			#<li_baz> = #<ap_z>
			#<li_bax> = #<ap_x>
		o<li_base> endif

		G0 Z[#<li_baz> + #<_li_leff> * #<li_bz>]
		G0 X[[#<li_bax> + #<_li_leff> * #<li_bx>] * #<_diameter_mode>]
		(the lead feed applies to the STRAIGHT lead only - the blend radius is)
		(already cutting into the part at the pass's own direction, so it runs)
		(at the pass feed like the rest of the cut. With no lead feed set both)
