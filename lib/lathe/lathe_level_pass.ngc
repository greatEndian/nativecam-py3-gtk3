		(all: seen=0 and ref=-999999 on every pass of window 5.)
		#<ld_az> = #<z_start>
		#<ld_sgn> = #<z_dir>
		o<ld_rev> if [#<_pl_cut_rev> GT 0]
			#<ld_az> = #<z_end_cut>
			#<ld_sgn> = [0 - #<z_dir>]
		o<ld_rev> endif
		(how far back the approach reaches. Deliberately generous - the ramp)
		(plus the straight lead plus a margin - because overstating it can)
		(only pull in an extra window and REFUSE the gate, while)
		(understating it would miss the neighbour that matters.)
		#<ld_len> = [#<pa_dz> + #<li_len> + #<_pl_z_clear> + 1.0]
		#<ld_z0> = #<ld_az>
