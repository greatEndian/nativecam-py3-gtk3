	#<s_cl>      = 0
	#<s_bcl>     = 0
	#<fc_i>      = 0
	#<fc_pz>     = 0
	#<fc_px>     = 0
	#<fc_cz>     = 0
	#<fc_cx>     = 0
	#<s_take>    = 0
	#<pa_dz>     = 0
	(read by the ramp arming below, which now sits outside the entry block)
	#<e_have>    = 0
