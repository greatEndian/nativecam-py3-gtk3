(one straight roughing pass at a fixed diameter over a lathe polyline)
(feeds along Z at the given level and stops at the first crossing of the)
(offset profile - radii, chamfers and tapers are only touched when the)
(level reaches them, and multi-section profiles rough in a single pass)
(sets #<_level_blocked> = 1 and cuts nothing when the profile already)
(rises above the level before the Z window starts)
o<lathe_level_pass> sub
(CALL pds[1] level[2] floor_off[3] w_from[4] w_to[5] pass_feed[6] li_len[7] li_ang[8] li_feed[9] lo_len[10] lo_ang[11] lo_feed[12] li_rad[13] lo_rad[14])

	#<pds>       = #1
	#<level>     = #2
	#<cross_t>   = #3
	#<w_from>    = #4
	#<w_to>      = #5
	#<pass_feed> = #6
	#<li_len>    = #7
	#<li_ang>    = #8
	#<li_feed>   = #9
	#<lo_len>    = #10
	#<lo_ang>    = #11
	#<lo_feed>   = #12
	#<li_rad>    = #13
	#<lo_rad>    = #14
	(where this pass may BEGIN. Defined here, not inside the branch that)
	(sets it: LinuxCNC pre-parses the whole file at load and a named)
	(parameter first assigned in a branch reads as "not defined".)
	(THE WINDOW START IS A RAW PROFILE Z, so the tip started where the SURFACE)
	(starts and the nose - which trails the tip by the orientation vector -)
	(began cutting past it: the drawn segment starts at Z+1.0000 and green began)
	(its cut at Z+1.4000. The level STOP has carried the nose since the stop)
	(table was built, so one end of the pass was compensated and the other was)
	(not. _pl_rgh_oz is already gated in Python - zero unless this polyline)
	(compensates - so there is nothing to decide here, only to subtract)
	#<z_start>   = [#<w_from> - #<_pl_rgh_oz>]
	(the profile-angle approach segment, resolved with z_start below)
	#<pa_on>     = 0
	#<pa_z>      = 0
	#<pa_x>      = 0
	#<e_bdz>     = 0
	#<e_bdx>     = 0
	#<e_sdz>     = 0
	#<e_sdx>     = 0
	#<e_asl>     = 0
	#<pa_dz>     = 0
	(read by the ramp arming below, which now sits outside the entry block)
	#<e_have>    = 0
	o<lif_def> if [#<li_feed> LE 0]
		#<li_feed> = #<pass_feed>
	o<lif_def> endif
	o<lof_def> if [#<lo_feed> LE 0]
		#<lo_feed> = #<pass_feed>
	o<lof_def> endif

	#<rec_count> = #[#<pds>]
	o<zdir> if [#<w_from> GE #<w_to>]
		#<z_dir> = 1
	o<zdir> else
		#<z_dir> = -1
	o<zdir> endif

	(first crossing of the level through the normally-offset profile:)
	(each segment is offset perpendicular by the floor allowance, so walls)
	(and tapers stop the pass the same distance away as the contour passes)
	(arcs are treated as their chords - the pre-finish pass trues them up)
	(the epsilon lets the level exactly on the roughing floor graze it)
	#<d_off> = #<cross_t>
	#<l_eff> = [#<level> + [0.001 * #<_mm>]]
	#<found> = 0
	#<have_prev> = 0
	#<zc>    = [#<w_to> - #<z_dir>]
	#<pz>    = #[#<pds> + 1]
	#<px>    = #[#<pds> + 2]
	#<scan_ptr> = [#<pds> + 9]
	#<scan_i>   = 1
	o<scan01> while [#<scan_i> LT #<rec_count>]
		#<scan_i> = [#<scan_i> + 1]
		#<cz> = #[#<scan_ptr>]
		#<cx> = #[#<scan_ptr> + 1]
		#<s_len> = SQRT[[#<cz> - #<pz>] * [#<cz> - #<pz>] + [#<cx> - #<px>] * [#<cx> - #<px>]]
		o<c_seg> if [[#<found> EQ 0] AND [#<s_len> GT 0.0001]]
			(outward normal of the segment, pointing away from the material)
			#<n_z> = [#<z_dir> * [#<cx> - #<px>] / #<s_len>]
			#<n_x> = [-#<z_dir> * [#<cz> - #<pz>] / #<s_len>]
			#<q1z> = [#<pz> + #<d_off> * #<n_z>]
			#<q1x> = [#<px> + #<d_off> * #<n_x>]
			#<q2z> = [#<cz> + #<d_off> * #<n_z>]
			#<q2x> = [#<cx> + #<d_off> * #<n_x>]

			(corner connector: adjacent segments offset independently and can)
			(leave a gap or overlap at the joint between them - e.g. a wall)
			(segment offsets purely in Z while a neighboring fillet arc chord)
			(offsets diagonally, so their offset ranges don't meet exactly.)
			(bridge the previous segment's offset end to this one's offset)
			(start with a straight connector before testing this segment.)
			o<gap> if [#<have_prev>]
				o<gap_hit> if [[#<pq2x> LT #<l_eff>] AND [#<q1x> GE #<l_eff>]]
					#<zc> = [#<pq2z> + [#<q1z> - #<pq2z>] * [#<l_eff> - #<pq2x>] / [#<q1x> - #<pq2x>]]
					#<found> = 1
				o<gap_hit> elseif [[#<pq2x> GE #<l_eff>] AND [#<q1x> LT #<l_eff>]]
					#<zc> = [#<pq2z> + [#<q1z> - #<pq2z>] * [#<l_eff> - #<pq2x>] / [#<q1x> - #<pq2x>]]
					#<found> = 1
				o<gap_hit> endif
			o<gap> endif

			o<c_ent> if [#<found>]
				(matched by the corner connector above)
			o<c_ent> elseif [[#<scan_i> EQ 2] AND [#<q1x> GE #<l_eff>]]
				(offset profile already above the level at its start)
				#<zc> = #<q1z>
				#<found> = 1
			o<c_ent> elseif [[#<q1x> LT #<l_eff>] AND [#<q2x> GE #<l_eff>]]
				#<zc> = [#<q1z> + [#<q2z> - #<q1z>] * [#<l_eff> - #<q1x>] / [#<q2x> - #<q1x>]]
				#<found> = 1
			o<c_ent> endif

			#<pq2z> = #<q2z>
			#<pq2x> = #<q2x>
			#<have_prev> = 1
		o<c_seg> endif
		#<pz> = #<cz>
		#<px> = #<cx>
		#<scan_ptr> = [#<scan_ptr> + 8]
	o<scan01> endwhile

	(multi-crossing continuation: the scan above always finds the array's very)
	(first crossing, which is stale/uninformative once w_from has moved past)
	(the array's true start on a continuation call from poly_lathe_mill's)
	(disjoint-interval loop - a second, direction-aware walk instead replays)
	(every crossing in array order to work out whether the profile is)
	(currently above the level right at w_from itself - the running state)
	(folds in every crossing at-or-before w_from, in order, then freezes -)
	(and separately finds the next qualifying entry into blocked territory)
	(strictly past w_from, for setting the cut target when not blocked)
	o<mcross> if [#<_pl_multi_cross> GT 0]
		#<mc_state> = 0
		#<mc_have_first> = 0
		#<mc_have_prev> = 0
		#<mc_wf_state> = -1
		#<mc_qual_found> = 0
		#<mc_zc> = [#<w_to> - #<z_dir>]
		#<mc_pz> = #[#<pds> + 1]
		#<mc_px> = #[#<pds> + 2]
		#<mc_scan_ptr> = [#<pds> + 9]
		#<mc_i> = 1
		o<mc01> while [#<mc_i> LT #<rec_count>]
			#<mc_i> = [#<mc_i> + 1]
			#<mc_cz> = #[#<mc_scan_ptr>]
			#<mc_cx> = #[#<mc_scan_ptr> + 1]
			#<mc_slen> = SQRT[[#<mc_cz> - #<mc_pz>] * [#<mc_cz> - #<mc_pz>] + [#<mc_cx> - #<mc_px>] * [#<mc_cx> - #<mc_px>]]
			o<mc_seg> if [#<mc_slen> GT 0.0001]
				#<mc_nz> = [#<z_dir> * [#<mc_cx> - #<mc_px>] / #<mc_slen>]
				#<mc_nx> = [-#<z_dir> * [#<mc_cz> - #<mc_pz>] / #<mc_slen>]
				#<mc_q1z> = [#<mc_pz> + #<d_off> * #<mc_nz>]
				#<mc_q1x> = [#<mc_px> + #<d_off> * #<mc_nx>]
				#<mc_q2z> = [#<mc_cz> + #<d_off> * #<mc_nz>]
				#<mc_q2x> = [#<mc_cx> + #<d_off> * #<mc_nx>]

				o<mc_first_chk> if [#<mc_have_first> EQ 0]
					o<mc_st0> if [#<mc_q1x> GE #<l_eff>]
						#<mc_state> = 1
					o<mc_st0> endif
					#<mc_have_first> = 1
				o<mc_first_chk> endif

				(gap-connector and in-segment crossings are independent events,)
				(not alternatives - a corner where two differently-oriented)
				(segments' offsets overshoot each other, e.g. a pure-radial)
				(step immediately followed by a shallow taper, can genuinely)
				(enter blocked territory via the gap bridge AND separately)
				(exit it again within the very next segment's own body. Testing)
				(them as an if/elseif pair - matching lathe_level_pass's plain)
				(single-crossing scan above, where only the first-ever match)
				(matters so the distinction is invisible - would silently drop)
				(the second event here, where every crossing must be replayed)
				#<mc_gap_found> = 0
				o<mc_gap> if [#<mc_have_prev>]
					#<mc_q1_prog>  = [-#<z_dir> * #<mc_q1z>]
					#<mc_pq2_prog> = [-#<z_dir> * #<mc_pq2z>]
					o<mc_foldchk> if [#<mc_q1_prog> GE [#<mc_pq2_prog> - 0.0001]]
						o<mc_gap_hit> if [[#<mc_pq2x> LT #<l_eff>] AND [#<mc_q1x> GE #<l_eff>]]
							#<mc_gap_tz> = [#<mc_pq2z> + [#<mc_q1z> - #<mc_pq2z>] * [#<l_eff> - #<mc_pq2x>] / [#<mc_q1x> - #<mc_pq2x>]]
							#<mc_gap_dirup> = 1
							#<mc_gap_found> = 1
						o<mc_gap_hit> elseif [[#<mc_pq2x> GE #<l_eff>] AND [#<mc_q1x> LT #<l_eff>]]
							#<mc_gap_tz> = [#<mc_pq2z> + [#<mc_q1z> - #<mc_pq2z>] * [#<l_eff> - #<mc_pq2x>] / [#<mc_q1x> - #<mc_pq2x>]]
							#<mc_gap_dirup> = 0
							#<mc_gap_found> = 1
						o<mc_gap_hit> endif
					o<mc_foldchk> endif
				o<mc_gap> endif

				#<mc_seg_found> = 0
				o<mc_ent> if [[#<mc_q1x> LT #<l_eff>] AND [#<mc_q2x> GE #<l_eff>]]
					#<mc_seg_tz> = [#<mc_q1z> + [#<mc_q2z> - #<mc_q1z>] * [#<l_eff> - #<mc_q1x>] / [#<mc_q2x> - #<mc_q1x>]]
					#<mc_seg_dirup> = 1
					#<mc_seg_found> = 1
				o<mc_ent> elseif [[#<mc_q1x> GE #<l_eff>] AND [#<mc_q2x> LT #<l_eff>]]
					#<mc_seg_tz> = [#<mc_q1z> + [#<mc_q2z> - #<mc_q1z>] * [#<l_eff> - #<mc_q1x>] / [#<mc_q2x> - #<mc_q1x>]]
					#<mc_seg_dirup> = 0
					#<mc_seg_found> = 1
				o<mc_ent> endif

				o<mc_use_gap> if [#<mc_gap_found>]
					o<mc_ispast_g> if [[#<z_dir> * [#<mc_gap_tz> - #<w_from>]] LT [-0.0001]]
						o<mc_freeze_g> if [#<mc_wf_state> LT 0]
							#<mc_wf_state> = #<mc_state>
						o<mc_freeze_g> endif
						o<mc_qual_g> if [[#<mc_gap_dirup>] AND [#<mc_qual_found> EQ 0]]
							#<mc_qual_found> = 1
							#<mc_zc> = #<mc_gap_tz>
						o<mc_qual_g> endif
					o<mc_ispast_g> else
						#<mc_state> = #<mc_gap_dirup>
					o<mc_ispast_g> endif
				o<mc_use_gap> endif

				o<mc_use_seg> if [#<mc_seg_found>]
					o<mc_ispast_s> if [[#<z_dir> * [#<mc_seg_tz> - #<w_from>]] LT [-0.0001]]
						o<mc_freeze_s> if [#<mc_wf_state> LT 0]
							#<mc_wf_state> = #<mc_state>
						o<mc_freeze_s> endif
						o<mc_qual_s> if [[#<mc_seg_dirup>] AND [#<mc_qual_found> EQ 0]]
							#<mc_qual_found> = 1
							#<mc_zc> = #<mc_seg_tz>
						o<mc_qual_s> endif
					o<mc_ispast_s> else
						#<mc_state> = #<mc_seg_dirup>
					o<mc_ispast_s> endif
				o<mc_use_seg> endif

				#<mc_pq2z> = #<mc_q2z>
				#<mc_pq2x> = #<mc_q2x>
				#<mc_have_prev> = 1
			o<mc_seg> endif
			#<mc_pz> = #<mc_cz>
			#<mc_px> = #<mc_cx>
			#<mc_scan_ptr> = [#<mc_scan_ptr> + 8]
		o<mc01> endwhile

		o<mc_finalize> if [#<mc_wf_state> LT 0]
			#<mc_wf_state> = #<mc_state>
		o<mc_finalize> endif

		o<mc_decide> if [#<mc_wf_state> GT 0]
			#<_level_blocked> = 1
			o<lathe_level_pass> return
		o<mc_decide> else
			#<found> = #<mc_qual_found>
			#<zc> = #<mc_zc>
		o<mc_decide> endif
	o<mcross> endif

	o<blk> if [[#<found>] AND [[#<z_dir> * [#<zc> - #<w_from>]] GE -0.0001]]
		(profile rises above this level before the window: nothing reachable)
		#<_level_blocked> = 1
		o<lathe_level_pass> return
	o<blk> endif

	(cut end: the crossing, clamped at the window end)
	o<zend> if [#<z_dir> GT 0]
		o<zend1> if [#<zc> GT #<w_to>]
			#<z_end> = #<zc>
		o<zend1> else
			#<z_end> = #<w_to>
		o<zend1> endif
	o<zend> else
		o<zend2> if [#<zc> LT #<w_to>]
			#<z_end> = #<zc>
		o<zend2> else
			#<z_end> = #<w_to>
		o<zend2> endif
	o<zend> endif
	(Extend the START back to the entry contour, when Python emitted one.)
	(w_from is where the level clears the FLOOR allowance and everything)
	(else keeps using it - the crossing scan above, the stop, the block)
	(test. But the pass need not wait that long to begin: entering behind)
	(the highest peak the tool can still reach, the floor allowance costs)
	(its own length over the sine of the ramp before the cut even starts.)
	(This walks a table lathe_sections built at generation time - the)
	(contour already offset by one roughing depth of cut - rather than)
	(offsetting anything itself. Read the table, move.)
	o<ent> if [#<_pl_entry_n> GT 0]
		#<e_i>    = 0
		#<e_best> = 0
		#<e_have> = 0
		#<e_pz> = #[#<_pl_entry_base>]
		#<e_px> = #[#<_pl_entry_base> + 1]
		o<e_w> while [#<e_i> LT [#<_pl_entry_n> - 1]]
			#<e_i> = [#<e_i> + 1]
			#<e_cz> = #[#<_pl_entry_base> + #<e_i> * 2]
			#<e_cx> = #[#<_pl_entry_base> + #<e_i> * 2 + 1]
			o<e_cross> if [[[#<e_px> - #<l_eff>] * [#<e_cx> - #<l_eff>]] LT 0]
				#<e_z> = [#<e_pz> + [#<e_cz> - #<e_pz>] * [#<l_eff> - #<e_px>] / [#<e_cx> - #<e_px>]]
				(this table segment's own direction - the profile angle the)
				(approach copies, taken from the contour rather than assumed)
				#<e_sdz> = [#<e_cz> - #<e_pz>]
				#<e_sdx> = [#<e_cx> - #<e_px>]
				(only a crossing the cut has not reached yet, and the nearest)
				o<e_bef> if [[#<z_dir> * [#<e_z> - #<w_from>]] GT 0.0001]
					o<e_near> if [[#<e_have> EQ 0] OR [[#<z_dir> * [#<e_z> - #<e_best>]] LT 0]]
						#<e_best> = #<e_z>
						#<e_bdz> = #<e_sdz>
						#<e_bdx> = #<e_sdx>
						#<e_have> = 1
					o<e_near> endif
				o<e_bef> endif
			o<e_cross> endif
			#<e_pz> = #<e_cz>
			#<e_px> = #<e_cx>
		o<e_w> endwhile
		o<e_ok> if [#<e_have>]
			#<z_start> = #<e_best>
			(the approach copies the contour's own angle here, running one)
			(roughing depth of cut of PROJECTED length back from the entry)
			(point, then turning onto the level. Arriving parallel to the)
			(surface it is about to leave beats driving in at 45 degrees.)
		o<e_ok> endif
	o<ent> endif

	(Extend the STOP to the pre-finish contour, when Python emitted one.)
	(The scan above keeps the FLOOR allowance - it is not only the stop, it)
	(also decides whether this level is blocked at all, and halving it let)
	(levels run on through material they were being held out of: 487 mm of)
	(cut became 875.6 and ten ends finished inside the contour. So the scan)
	(is left alone and the stop is looked up in a table lathe_sections built)
	(at generation time. Bounded by w_to, and only ever extended - never)
	(pulled back - so a level cannot reach further than its window allows.)
	o<stp> if [[#<_pl_stop_n> GT 0] AND [#<found>]]
		#<s_i>    = 0
		#<s_best> = 0
		#<s_have> = 0
		#<s_pz> = #[#<_pl_stop_base>]
		#<s_px> = #[#<_pl_stop_base> + 1]
		o<s_w> while [#<s_i> LT [#<_pl_stop_n> - 1]]
			#<s_i> = [#<s_i> + 1]
			#<s_cz> = #[#<_pl_stop_base> + #<s_i> * 2]
			#<s_cx> = #[#<_pl_stop_base> + #<s_i> * 2 + 1]
			o<s_cross> if [[[#<s_px> - #<l_eff>] * [#<s_cx> - #<l_eff>]] LT 0]
				#<s_z> = [#<s_pz> + [#<s_cz> - #<s_pz>] * [#<l_eff> - #<s_px>] / [#<s_cx> - #<s_px>]]
				(only a crossing further along the cut than the scan found,)
				(and still inside the window - the nearest such)
				o<s_fwd> if [[[#<z_dir> * [#<s_z> - #<z_end>]] LT -0.0001] AND [[#<z_dir> * [#<s_z> - #<w_to>]] GT -0.0001]]
					o<s_near> if [[#<s_have> EQ 0] OR [[#<z_dir> * [#<s_z> - #<s_best>]] GT 0]]
						#<s_best> = #<s_z>
						#<s_have> = 1
					o<s_near> endif
				o<s_fwd> endif
			o<s_cross> endif
			#<s_pz> = #<s_cz>
			#<s_px> = #<s_cx>
		o<s_w> endwhile
		o<s_ok> if [#<s_have>]
			#<z_end> = #<s_best>
		o<s_ok> endif
	o<stp> endif

	(THE PROFILE-ANGLE APPROACH IS ARMED HERE, AFTER THE STOP, not up in the)
	(entry block where its inputs are found. Its cap - never longer than the)
	(cut it is entering - was being tested against the SCAN's z_end, and the)
	(stop table then extends that cut. On testing_15_2 the last pass behind the)
	(boss came out 2.6397 long against a 2.2004 ramp, so the ramp fitted, but)
	(the pre-extension length did not clear it: that pass alone lost its ramp)
	(and plunged in at 45 degrees instead of arriving along the surface. It is)
	(visible as the odd one out because Sectioning gives that region a longer)
	(window and the same cap then passes - greatEndian: "if I select sectioning)
	(the lead in shape is right".)
	o<e_arm> if [[#<e_have>] AND [ABS[#<e_bdz>] GT 0.000001] AND [#<_rough_cut> GT 0]]
		#<e_slope> = [#<e_bdx> / #<e_bdz>]
		#<e_asl>   = ABS[#<e_slope>]
		(the depth of cut is a RADIAL quantity, so it is PROJECTED onto the)
		(contour's own angle rather than used as a length: one depth of cut of)
		(radius costs doc/sin of the angle along the segment and doc/tan of it)
		(in Z. On a 13 degree ramp that is 2.20 mm of Z for a 0.508 mm cut.)
		o<e_proj> if [#<e_asl> GT 0.000001]
			#<pa_dz> = [#<_rough_cut> / #<e_asl>]
			(never longer than the cut it is entering - now the REAL one)
			o<e_cap> if [#<pa_dz> LT ABS[#<z_end> - #<z_start>]]
				#<pa_z> = [#<z_start> + #<z_dir> * #<pa_dz>]
				#<pa_x> = [#<level> + #<z_dir> * #<pa_dz> * #<e_slope>]
				#<pa_on> = 1
			o<e_cap> endif
		o<e_proj> endif
	o<e_arm> endif


	(exposed for callers doing their own disjoint-interval scanning after this)
	(call - e.g. lathe_level_next_start needs to know where THIS pass actually)
	(stopped cutting, to search for a further interval past it)
	#<_pl_level_z_end> = #<z_end>

	(resolve the lead-out radius and the possibly-shortened cut end BEFORE the)
	(straight cut, so a cut ending near a wall can stop just early enough that)
	(a full-radius lead-out arc still lands tangent to the pre-finish contour)
	(instead of the radius being clipped to a constant. z_end - the logical)
	(floor crossing - is left untouched for the interval/blocking logic and)
	(the _pl_level_z_end export; only the physical straight-cut endpoint and)
	(the fillet's own tangent point move)
	#<z_end_cut> = #<z_end>

	o<lo_res> if [[#<lo_len> GT 0] OR [#<lo_rad> GT 0]]
		(lead-out line direction: unit vector pointing from the exit toward)
		(the far rapid point - 0 degrees along Z surface, 90 radial)
		#<lo_bz> = [#<z_dir> * COS[#<lo_ang>]]
		#<lo_bx> = [#<_pl_x_sgn> * SIN[#<lo_ang>]]
		#<_lo_cos> = [#<z_dir> * #<lo_bz>]
		#<_lo_leff> = #<lo_len>

		(mirrors the lead-in's own _li_leff/li_cap_all cap above, and bounds the)
		(same end of the interval it does. The retreat travels BACKWARD, from)
		(z_end toward w_from, for either z_dir - lo_bz carries z_dir, so the)
		(move Z[end_z + _lo_leff * lo_bz] always runs against the cutting)
		(direction. What it must not reach past is therefore w_from: on a)
		(multi-crossing continuation interval that is where the boss blocking)
		(the sweep sits. Measuring toward w_to instead bounded the one direction)
		(the retreat never travels, which both deleted the lead-out outright)
		(whenever a pass ran its whole window - z_end clamped to w_to, so zero)
		(room, which is what left every artificial slice ending bare - and let)
		(a continuation interval retreat run back over its own start when the)
		(room ahead happened to be large. Gated on multi-crossing so the)
		(single-crossing path stays byte-for-byte unchanged)
		o<lo_cap_all> if [#<_pl_multi_cross> GT 0]
			#<_lo_room> = ABS[#<z_end> - #<w_from>]
			o<lo_lcap> if [#<_lo_cos> GT 0.0001]
				#<_lo_lmax> = [#<_lo_room> / #<_lo_cos>]
				o<lo_lcap2> if [#<_lo_leff> GT #<_lo_lmax>]
					#<_lo_leff> = #<_lo_lmax>
				o<lo_lcap2> endif
			o<lo_lcap> endif
		o<lo_cap_all> endif

		(radius is bounded by how much straight lead length there is to blend)
		(into - a big radius with a short lead would swing wider than lo_len)
		(can absorb; half-angle from the arrival vs lead-out directions)
		#<_lo_reff> = #<lo_rad>
		o<lo_rlen> if [#<lo_len> GT 0]
			#<_lo_sin> = ABS[#<z_dir> * #<lo_bx>]
			#<_lo_rmax> = [#<_lo_leff> * #<_lo_sin> / [1 + #<_lo_cos>]]
			o<lo_rlen2> if [#<_lo_reff> GT #<_lo_rmax>]
				#<_lo_reff> = #<_lo_rmax>
			o<lo_rlen2> endif
		o<lo_rlen> endif

		(pre-finish tangency by POSITION, not by clipping the radius: the arc's)
		(circle is always centered on the cut end in Z, so its lowest point is)
		(radius below that - see poly_lathe_mill.ngc lo_rad_cap. To keep the)
		(user's radius AND land tangent to the pre-finish contour, which sits)
		(_lo_rad_cap toward the wall from the roughing floor, pull the cut end)
		(back toward the window start by exactly the excess, so the circle)
		(bottoms out ON the pre-finish line rather than past it. Guard: a short)
		(multi-crossing interval with no room to pull back falls back to)
		(clipping the radius, so it still cannot overflow)
		o<lo_pull> if [[#<lo_rad> GT 0] AND [#<_lo_reff> GT #<_lo_rad_cap>]]
			#<z_end_try> = [#<z_end> + #<z_dir> * [#<_lo_reff> - #<_lo_rad_cap>]]
			o<lo_pull2> if [[#<z_dir> * [#<w_from> - #<z_end_try>]] GT 0.0001]
				#<z_end_cut> = #<z_end_try>
			o<lo_pull2> else
				#<_lo_reff> = #<_lo_rad_cap>
			o<lo_pull2> endif
		o<lo_pull> endif
	o<lo_res> endif

	(Skip a pass too short to be worth making. A level whose cut is only a)
	(fraction of the tool sits almost entirely inside the pre-finish allowance)
	(anyway - the contour pass that follows takes the same metal in one go - so)
	(cutting it costs an approach and a retract to remove almost nothing.)
	(BEFORE the approach and the lead-in, not after them: returning later still)
	(left the whole entry behind - retract, rapid to the lead start, then a FEED)
	(into the workpiece - and then walked away without cutting the pass it had)
	(just entered for. A skipped pass now emits no motion at all.)
	(Measured on z_end_cut, which is why the lead-out resolution above it moved)
	(up here too: that block is pure arithmetic, it emits nothing, and the pull)
	(back it applies is what decides how long this cut really is. Measuring the)
	(raw crossing instead read the pass longer than it is and the gate missed)
	(the passes it exists for.)
	(_pl_level_z_end is already set above, so the disjoint-interval scan still)
	(knows where this level reached and carries on past it.)
	o<shrt> if [#<_pl_min_pass> GT 0]
		o<shrt2> if [ABS[#<z_end_cut> - #<z_start>] LT #<_pl_min_pass>]
			o<lathe_level_pass> return
		o<shrt2> endif
	o<shrt> endif


	(approach: full retract above stock, or minimal retract just above the)
	(previous pass level - safe because that band is already cut)
	o<ret_md> if [#<_pl_ret_mode> GT 0]
		#<ret_x> = [[#<_pl_prev_lvl> + #<_pl_ret_dist>] * #<_diameter_mode>]
		o<ret_cap> if [[#<_pl_side> EQ 0] AND [#<ret_x> GT [#<_wp_dia_od> + #<_x_clear>]]]
			#<ret_x> = [#<_wp_dia_od> + #<_x_clear>]
		o<ret_cap> endif
		G0 X#<ret_x>
	o<ret_md> else
		o<rt_side> if [#<_pl_side> EQ 1]
			G0 X#<_pl_id_ret>
		o<rt_side> else
			G0 X[#<_wp_dia_od> + #<_x_clear>]
		o<rt_side> endif
	o<ret_md> endif
	(where the approach LANDS: the start of the profile-angle segment when)
	(there is one, else the pass start itself. Both the lead-in branch and)
	(the plain-rapid branch use it, because the segment is NOT part of the)
	(lead-in - it is there whether or not a lead-in was asked for, and the)
	(project that wanted it has lead-in length and radius both 0.)
	#<ap_z> = #<z_start>
	#<ap_x> = #<level>
	o<ap_use> if [#<pa_on>]
		#<ap_z> = #<pa_z>
		#<ap_x> = #<pa_x>
	o<ap_use> endif

	o<lead_in> if [[#<li_len> GT 0] OR [#<li_rad> GT 0]]
		(a level pass always travels along Z at constant X, so the toolpath's)
		(own direction at the entry is always pure Z - no profile lookup needed)
		#<li_bz> = [#<z_dir> * COS[#<li_ang>]]
		#<li_bx> = [#<_pl_x_sgn> * SIN[#<li_ang>]]
		#<_li_leff> = #<li_len>
		#<_li_reff> = #<li_rad>

		(multi-crossing continuation intervals can be short - the entry's own)
		(depth excursion, li_len times cos of li_ang, must not reach past z_end, or)
		(the entry line itself would cut into territory this interval was)
		(never meant to touch. z_end is already known here regardless of)
		(whether this is the first or a later interval, so cap against the)
		(actual room instead of the caller unconditionally zeroing the whole)
		(lead for every interval after the first. Gated on multi-crossing so)
		(the single-crossing path is byte-for-byte unchanged - it never had)
		(this cap and first intervals there are assumed to have enough room.)
		(li_rad itself is deliberately left uncapped, matching the contour)
		(pass's own lead-in in lathe_poly_pass.ngc, which has never capped)
		(it either - only the straight length risks cutting past z_end)
		o<li_cap_all> if [#<_pl_multi_cross> GT 0]
			#<_li_room> = ABS[#<z_end> - #<w_from>]
			#<_li_cos>  = [#<z_dir> * #<li_bz>]
			o<li_lcap> if [#<_li_cos> GT 0.0001]
				#<_li_lmax> = [#<_li_room> / #<_li_cos>]
				o<li_lcap2> if [#<_li_leff> GT #<_li_lmax>]
					#<_li_leff> = #<_li_lmax>
				o<li_lcap2> endif
			o<li_lcap> endif
		o<li_cap_all> endif

		#<_flt_ok> = 0
		o<li_geom> if [#<_li_reff> GT 0]
			o<fillet_lead> CALL [#<ap_z>] [#<ap_x>] [-#<z_dir>] [0] [#<li_bz>] [#<li_bx>] [#<_li_reff>] [#<z_dir>]
		o<li_geom> endif

		o<li_base> if [#<_flt_ok>]
			#<li_baz> = #<_flt_t1z>
			#<li_bax> = #<_flt_t1x>
		o<li_base> else
			#<li_baz> = #<ap_z>
			#<li_bax> = #<ap_x>
		o<li_base> endif

		G0 Z[#<li_baz> + #<_li_leff> * #<li_bz>]
		G0 X[[#<li_bax> + #<_li_leff> * #<li_bx>] * #<_diameter_mode>]
		(the lead feed applies to the STRAIGHT lead only - the blend radius is)
		(already cutting into the part at the pass's own direction, so it runs)
		(at the pass feed like the rest of the cut. With no lead feed set both)
		(resolve to the pass feed and the whole approach is one feed)
		F#<li_feed>
		o<li_str> if [#<_li_leff> GT 0]
			G1 X[#<li_bax> * #<_diameter_mode>] Z#<li_baz>
		o<li_str> endif
		o<li_fsw> if [#<li_feed> NE #<pass_feed>]
			F#<pass_feed>
		o<li_fsw> endif
		o<li_arc> if [#<_flt_ok>]
			(tangent blend from the lead-in line into the pass's own)
			(direction, instead of a sharp corner)
			o<li_arc_d> if [#<_flt_cw>]
				G2 X[#<ap_x> * #<_diameter_mode>] Z#<ap_z> I[#<_flt_cx> - #<li_bax>] K[#<_flt_cz> - #<li_baz>]
			o<li_arc_d> else
				G3 X[#<ap_x> * #<_diameter_mode>] Z#<ap_z> I[#<_flt_cx> - #<li_bax>] K[#<_flt_cz> - #<li_baz>]
			o<li_arc_d> endif
		o<li_arc> endif
		F#<pass_feed>
	o<lead_in> else
		G0 Z[#<ap_z> + #<z_dir> * #<_pl_z_clear>]
		G0 X[#<ap_x> * #<_diameter_mode>]
	o<lead_in> endif

	(the profile-angle approach, outside the lead-in branch on purpose)
	o<pa_cut> if [#<pa_on>]
		F#<pass_feed>
		G1 X[#<ap_x> * #<_diameter_mode>] Z#<ap_z>
		(the turn onto the level, at the entry point)
		G1 X[#<level> * #<_diameter_mode>] Z#<z_start>
	o<pa_cut> endif


	G1 Z#<z_end_cut>

	(retreat lead-out: back toward the window start, rising away from the cut)
	o<lead_out> if [[#<lo_len> GT 0] OR [#<lo_rad> GT 0]]
		#<phys_x> = #<level>
		#<end_z>  = #<z_end_cut>
		(the blend radius still leaves the part, so it stays at the pass feed;)
		(only the straight retreat below runs at the lead-out feed. Both)
		(branches emit exactly one F, so with no lead feed set this is the)
		(same line the pass always emitted)
		o<lo_fsw> if [#<lo_feed> NE #<pass_feed>]
			F#<pass_feed>
		o<lo_fsw> else
			F#<lo_feed>
		o<lo_fsw> endif

		#<_flt_ok> = 0
		o<lo_geom> if [#<lo_rad> GT 0]
			(arrival direction at the pass end is the same pure Z travel -)
			(the lead direction is negated because fillet_lead's T1 formula)
			(assumes travel INTO T1 along -lead; lead-out actually travels)
			(OUT of T1 along +lead, so the sense fed in must be reversed to)
			(place T1 where it is actually tangent to the real lo_str line)
			o<fillet_lead> CALL [#<end_z>] [#<phys_x>] [-#<z_dir>] [0] [-#<lo_bz>] [-#<lo_bx>] [#<_lo_reff>] [#<z_dir>]
		o<lo_geom> endif

		o<lo_arc> if [#<_flt_ok>]
			(traversed V-to-T1, the reverse of how the utility defines the)
			(sweep, so the direction is flipped - verified numerically by)
			(checking actual tangent direction continuity at both ends, not)
			(just that the arc is a valid circle)
			o<lo_arc_d> if [#<_flt_cw>]
				G3 X[#<_flt_t1x> * #<_diameter_mode>] Z#<_flt_t1z> I[#<_flt_cx> - #<phys_x>] K[#<_flt_cz> - #<end_z>]
			o<lo_arc_d> else
				G2 X[#<_flt_t1x> * #<_diameter_mode>] Z#<_flt_t1z> I[#<_flt_cx> - #<phys_x>] K[#<_flt_cz> - #<end_z>]
			o<lo_arc_d> endif
			#<phys_x> = #<_flt_t1x>
			#<end_z>  = #<_flt_t1z>
		o<lo_arc> endif
		o<lo_str> if [#<_lo_leff> GT 0]
			o<lo_fsw2> if [#<lo_feed> NE #<pass_feed>]
				F#<lo_feed>
			o<lo_fsw2> endif
			G1 X[[#<phys_x> + #<_lo_leff> * #<lo_bx>] * #<_diameter_mode>] Z[#<end_z> + #<_lo_leff> * #<lo_bz>]
		o<lo_str> endif
		F#<pass_feed>
	o<lead_out> endif

o<lathe_level_pass> endsub
