				F#<lo_feed>
			o<lo_fsw2> endif
			G1 X[[#<phys_x> + #<_lo_leff> * #<lo_bx>] * #<_diameter_mode>] Z[#<end_z> + #<_lo_leff> * #<lo_bz>]
		o<lo_str> endif
		F#<pass_feed>
	o<lead_out> endif

o<lathe_level_pass> endsub
