			#<ld_z0> = #<ld_z1>
			#<ld_z1> = #<ld_az>
		o<ld_ord> endif
		#<ld_ref> = -999999
		#<ld_seen> = 0
		#<ld_i> = 0
		o<ld_w> while [#<ld_i> LT #<_pl_sect_count>]
			o<ld_self> if [#<ld_i> NE #<_pl_w_idx>]
				#<ld_wf> = #[3400 + #<ld_i> * 4 + 1]
				#<ld_wt> = #[3400 + #<ld_i> * 4 + 2]
