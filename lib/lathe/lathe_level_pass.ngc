			#<pk_bk> = [#<pk_at> - #<pk_dir> * #<_pl_peck_ret>]
			o<pk_clamp> if [[#<pk_dir> * [#<pk_bk> - #<z_start>]] LT 0]
				#<pk_bk> = #<z_start>
			o<pk_clamp> endif
			G1 Z#<pk_bk>
			G1 Z#<pk_at>
		o<pk_w> endwhile
		G1 Z#<z_end_cut>
	o<peck> else
		G1 Z#<z_end_cut>
	o<peck> endif


	(retreat lead-out: back toward the window start, rising away from the cut)
	o<lead_out> if [[#<lo_len> GT 0] OR [#<lo_rad> GT 0]]
		#<phys_x> = #<level>
		#<end_z>  = #<z_end_cut>
