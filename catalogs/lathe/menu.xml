<ncam_ui>
	<menu>
		<menu action='tools'  name=_("Tools")_ icon="lathe-tool.png">
			<menuitem action='ch_tool'  name=_("Change Cutter")_ tool_tip= _("Change cutter")_ icon="lathe-tool-change.png" src="lathe/tool-change.cfg"/>
			<menuitem action='iturning'  name=_("Initial Turning")_ tool_tip= _("Initial turning to help find X axis center")_ icon="od.png" src="lathe/init-turning.cfg"/>
		</menu>
		<menu action='cutting'  name=_("Cutting")_ icon="threading.png">
			<menu action='contour'  name=_("Contour")_ icon="polyline.png" tool_tip=_("Profile operations built from a polyline - the general way to cut a shape")_>
				<menuitem action='poly_start'  name=_("Outside Contour")_ tool_tip= _("Starts a polyline profile on the outside diameter")_ icon="lathe-surface.png" src="lathe/polyline.cfg"/>
				<separator/>
				<menuitem action='polyline_to'  name=_("Line To")_ tool_tip= _("Relative or absolute position")_ icon="line-to.png" src="lathe/polyline-to.cfg"/>
				<menuitem action='polyline_pol'  name=_("Line Polar")_ tool_tip= _("Define angle and length")_ icon="line-polar.png" src="lathe/polyline-polar.cfg"/>
				<menuitem action='poly_arc_ij'  name=_("Arc I,K")_ tool_tip= _("Defined center by offsets or absolute position")_ icon="arc-to-ij.png" src="lathe/polyline-arc-ij.cfg"/>
				<menuitem action='poly_arc_coords'  name=_("Arc To Coords")_ tool_tip= _("Define end point, arc height or radius")_ icon="arc-to-coords.png" src="lathe/polyline-arc-to.cfg"/>
			</menu>
			<menuitem action='facing'  name=_("Facing")_ tool_tip= _("Finish face and optionnaly touch off")_ icon="lathe-facing.png" src="lathe/facing.cfg"/>
			<menuitem action='threading'  name=_("Threading")_ tool_tip= _("External or internal threads, metric or imperial")_ icon="threading.png" src="lathe/threading.cfg"/>
			<menu action='primitives'  name=_("Primitives")_ icon="misc.png" tool_tip=_("Single-shape operations - one cut each, no profile needed")_>
				<menu action='prim_od'  name=_("Outside")_ icon="lathe-surface.png" tool_tip=_("External single-shape cuts")_>
					<menuitem action='turning'  name=_("External Turning")_ tool_tip= _("Does straight turning")_ icon="lathe-surface.png" src="lathe/turning.cfg"/>
					<menuitem action='taper_oda'  name=_("Taper ODA")_ tool_tip= _("External taper by angle and diameters")_ icon="taper-oda.png" src="lathe/taper_oda.cfg"/>
					<menuitem action='taper_odl'  name=_("Taper ODL")_ tool_tip= _("External taper by length and diameters")_ icon="taper-odl.png" src="lathe/taper_odl.cfg"/>
					<menuitem action='radius_od'  name=_("Radius OD")_ tool_tip= _("Finish with an external radius")_ icon="corner-radius.png" src="lathe/radius_od.cfg"/>
				</menu>
				<menu action='prim_id'  name=_("Inside")_ icon="lathe-surface-id.png" tool_tip=_("Internal single-shape cuts")_>
					<menuitem action='boring'  name=_("Internal Boring")_ tool_tip= _("Does straight boring")_ icon="lathe-surface-id.png" src="lathe/boring.cfg"/>
					<menuitem action='taper_ida'  name=_("Taper IDA")_ tool_tip= _("Internal taper by angle and diameters")_ icon="taper-ida.png" src="lathe/taper_ida.cfg"/>
					<menuitem action='taper_idl'  name=_("Taper IDL")_ tool_tip= _("Internal taper by length and diameters")_ icon="taper-idl.png" src="lathe/taper_idl.cfg"/>
				</menu>
				<menu action='prim_face'  name=_("Face")_ icon="lathe-facing.png" tool_tip=_("Face-direction single-shape cuts")_>
					<menuitem action='parting'  name=_("Parting Off")_ tool_tip= _("Cut your part from initial material")_ icon="parting.png" src="lathe/parting.cfg"/>
				</menu>
			</menu>
			<group name="Live Tooling">
			    <menuitem action="face_mill" name="Face Mill (G17)" src="lathe/face_mill.cfg" icon="face.png" tool_tip="Face milling operation on the lathe face using live tooling."/>
			    <menuitem action="cross_mill" name="Cross Mill (G19)" src="lathe/cross_mill.cfg" icon="cross_mill.png" tool_tip="Cross milling operation on the lathe OD using live tooling."/>
			    <menuitem action="face_slot" name="Face Slot (G17)" src="lathe/face_slot.cfg" icon="slot.png" tool_tip="Face slotting operation on the lathe face using live tooling."/>
			    <menuitem action="face_rect" name="Face Rectangle (G17)" src="lathe/face_rect.cfg" icon="rect.png" tool_tip="Face rectangle milling operation on the lathe face using live tooling."/>
			    <menuitem action="cross_rect" name="Cross Rectangle (G19)" src="lathe/cross_rect.cfg" icon="rect.png" tool_tip="Cross rectangle milling operation on the lathe OD using live tooling."/>
			    <menuitem action="face_polygon" name="Face Polygon (G17)" src="lathe/face_polygon.cfg" icon="polygon.png" tool_tip="Face polygon milling operation on the lathe face using live tooling."/>
			    <menuitem action="cross_polygon" name="Cross Polygon (G19)" src="lathe/cross_polygon.cfg" icon="polygon.png" tool_tip="Cross polygon milling operation on the lathe OD using live tooling."/>
			    <separator/>
			    <menuitem action="c_array" name="C-Axis Array" src="lathe/c_array.cfg" icon="circular-array.png" tool_tip="Create a circular array of items by indexing the Lathe C-axis."/>
			    <menuitem action="z_array" name="Z-Axis Line Array" src="lathe/z_array.cfg" icon="linear-array.png" tool_tip="Create a linear array of items by stepping along the Z-axis."/>
			</group>
		</menu>
		<menu action='misc'  name=_('Miscellaneous')_ icon='misc.png'>
			<menuitem action='group_std' name=_('Standard Group')_ tool_tip=_('Group subroutines')_ icon="group.png" src="group.cfg"/>
			<menuitem action='gcode_file'  name=_('Insert a G Code File')_ tool_tip= _('Include a custom gcode file')_ icon="file-gcode.png" src="i_gcode.cfg"/>
			<menuitem action='gcode'  name=_('Custom G Code')_ tool_tip= _('Write custom gcode')_ icon="gcode.png" src="gcode.cfg"/>
			<menuitem action='stock' name=_('Material')_ tool_tip=_('Lathe round stock')_ icon="l-stock.png" src="lathe/material.cfg"/>
            <menuitem action='prjdesc' name=_('Project Notes')_ tool_tip=_('View project name and note')_ icon="prj-desc.png" src="proj_desc.cfg"/>
		</menu>
	</menu>

    <toolbar>
        <toolitem action='ch_tool' />
        <separator/>
        <toolmenu action='contour' icon="polyline.png" tool_tip=_("Contour operations - a profile built from a polyline")_ />
        <toolitem action='facing' />
        <toolitem action='threading' />
        <separator/>
        <toolmenu action='primitives' icon="misc.png" tool_tip=_("Single-shape operations - turning, boring, tapers, parting")_ />
        <separator/>
        <toolitem action='group_std' />
        <separator/>
        <toolitem action='gcode' />
        <toolitem action='gcode_file' />
    </toolbar >
</ncam_ui>
